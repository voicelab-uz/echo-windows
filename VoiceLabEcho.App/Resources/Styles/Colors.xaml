<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Windows 11 Accent Colors -->
    <SolidColorBrush x:Key="PrimaryColor" Color="#0078D4"/>
    <SolidColorBrush x:Key="PrimaryHoverColor" Color="#106EBE"/>
    <SolidColorBrush x:Key="PrimaryPressedColor" Color="#005A9E"/>

    <!-- Background Colors -->
    <SolidColorBrush x:Key="BackgroundColor" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="SurfaceColor" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBackgroundColor" Color="#FAFAFA"/>

    <!-- Border Colors -->
    <SolidColorBrush x:Key="BorderColor" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="DividerColor" Color="#D0D0D0"/>

    <!-- Text Colors -->
    <SolidColorBrush x:Key="TextPrimaryColor" Color="#000000"/>
    <SolidColorBrush x:Key="TextSecondaryColor" Color="#666666"/>
    <SolidColorBrush x:Key="TextTertiaryColor" Color="#999999"/>
    <SolidColorBrush x:Key="TextDisabledColor" Color="#CCCCCC"/>

    <!-- State Colors -->
    <SolidColorBrush x:Key="SuccessColor" Color="#107C10"/>
    <SolidColorBrush x:Key="WarningColor" Color="#FFB900"/>
    <SolidColorBrush x:Key="ErrorColor" Color="#D13438"/>
    <SolidColorBrush x:Key="InfoColor" Color="#0078D4"/>

    <!-- Hover/Focus States -->
    <SolidColorBrush x:Key="HoverBackgroundColor" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="PressedBackgroundColor" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="FocusBorderColor" Color="#0078D4"/>

</ResourceDictionary>
