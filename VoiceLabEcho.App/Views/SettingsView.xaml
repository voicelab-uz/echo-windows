<UserControl x:Class="VoiceLabEcho.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="24">
            <TextBlock Text="Settings" FontSize="24" FontWeight="Bold" Margin="0,0,0,24"/>

            <Border Background="White" Padding="24" CornerRadius="8" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="Theme" Margin="0,0,0,8"/>
                    <ComboBox SelectedItem="{Binding SelectedTheme}">
                        <ComboBoxItem Content="Light"/>
                        <ComboBoxItem Content="Dark"/>
                        <ComboBoxItem Content="System"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Background="White" Padding="24" CornerRadius="8" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Startup" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <CheckBox Content="Launch at Windows startup" IsChecked="{Binding LaunchAtStartup}"/>
                </StackPanel>
            </Border>

            <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" Padding="16,8" HorizontalAlignment="Left"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
