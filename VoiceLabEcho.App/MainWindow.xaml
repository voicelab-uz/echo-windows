<Window x:Class="VoiceLabEcho.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Voice Lab Echo"
        Height="720"
        Width="880"
        MinHeight="600"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        ResizeMode="CanResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Window Background -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F9F9F9"/>
        <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#FFFFFF"/>

        <!-- Sidebar Item Style -->
        <Style x:Key="SidebarButtonStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border"
                                Background="Transparent"
                                Padding="12,8"
                                Margin="4,2"
                                CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E6E6E6"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E0E0E0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#D0D0D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="180" MaxWidth="300"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="#CCCCCC"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Header -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="12,12,12,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Voice Lab Echo"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#000000"/>
                </StackPanel>

                <!-- Navigation Menu -->
                <ScrollViewer Grid.Row="1"
                              Margin="0,12,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,0">
                        <RadioButton x:Name="HomeButton"
                                     Content="Home"
                                     Style="{StaticResource SidebarButtonStyle}"
                                     IsChecked="True"
                                     GroupName="Navigation"
                                     Click="OnNavigationClick"
                                     Tag="Home"/>

                        <RadioButton x:Name="StatisticsButton"
                                     Content="Statistics"
                                     Style="{StaticResource SidebarButtonStyle}"
                                     GroupName="Navigation"
                                     Click="OnNavigationClick"
                                     Tag="Statistics"/>

                        <RadioButton x:Name="VocabularyButton"
                                     Content="Vocabulary"
                                     Style="{StaticResource SidebarButtonStyle}"
                                     GroupName="Navigation"
                                     Click="OnNavigationClick"
                                     Tag="Vocabulary"/>

                        <RadioButton x:Name="NotesButton"
                                     Content="Notes"
                                     Style="{StaticResource SidebarButtonStyle}"
                                     GroupName="Navigation"
                                     Click="OnNavigationClick"
                                     Tag="Notes"/>

                        <RadioButton x:Name="GettingStartedButton"
                                     Content="Getting Started"
                                     Style="{StaticResource SidebarButtonStyle}"
                                     GroupName="Navigation"
                                     Click="OnNavigationClick"
                                     Tag="GettingStarted"/>

                        <Separator Margin="4,12" Background="#D0D0D0" Height="1"/>

                        <RadioButton x:Name="SettingsButton"
                                     Content="Settings"
                                     Style="{StaticResource SidebarButtonStyle}"
                                     GroupName="Navigation"
                                     Click="OnNavigationClick"
                                     Tag="Settings"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Profile Section -->
                <Border Grid.Row="2"
                        Background="#EEEEEE"
                        Padding="12"
                        BorderBrush="#CCCCCC"
                        BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock x:Name="UserNameText"
                                   Text="Loading..."
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="#000000"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="RemainingMinutesText"
                                   Text="-- minutes remaining"
                                   FontSize="11"
                                   Foreground="#666666"
                                   Margin="0,4,0,0"/>
                        <ProgressBar x:Name="UsageProgressBar"
                                     Height="6"
                                     Margin="0,8,0,0"
                                     Value="0"
                                     Maximum="100"
                                     Foreground="#0078D4"
                                     Background="#E1E1E1"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- GridSplitter for resizable sidebar -->
        <GridSplitter Grid.Column="1"
                      Width="4"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      ShowsPreview="True"
                      ResizeBehavior="PreviousAndNext"
                      Cursor="SizeWE"/>

        <!-- Content Area -->
        <Border Grid.Column="2"
                Background="{StaticResource ContentBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Content Header -->
                <Border Grid.Row="0"
                        Background="White"
                        BorderBrush="#E5E5E5"
                        BorderThickness="0,0,0,1"
                        Padding="20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ContentHeaderText"
                                   Text="Home"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#000000"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                x:Name="RecordButton"
                                Content="🎤 Start Recording"
                                Padding="16,8"
                                Background="#0078D4"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="OnRecordButtonClick">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ButtonBorder"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#106EBE"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#005A9E"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#CCCCCC"/>
                                                        <Setter Property="Foreground" Value="#999999"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!-- Content View -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ContentControl x:Name="ContentArea"
                                    Margin="0"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
