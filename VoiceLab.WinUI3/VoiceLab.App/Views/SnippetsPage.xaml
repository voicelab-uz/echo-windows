<Page
    x:Class="VoiceLab.App.Views.SnippetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BackgroundBrush}">
    <Grid x:Name="PageGrid" Padding="20" RowSpacing="20" MaxWidth="1040" HorizontalAlignment="Stretch" SizeChanged="OnPageSizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="Your snippets" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Say a short phrase. Echo types the full text for you." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="18">
        <StackPanel Spacing="12">
        <TextBlock Text="Create a snippet" FontWeight="SemiBold"/>
        <Grid x:Name="SnippetEntryGrid" ColumnSpacing="12" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <TextBox x:Name="NameBox" Header="When you say" PlaceholderText="e.g. my signature" MaxLength="100"/>
            <TextBox x:Name="TextBox" Grid.Column="1" Header="Echo writes" PlaceholderText="The text to insert…" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88" MaxLength="10000"/>
            <Button x:Name="SaveSnippetButton" Grid.Row="2" Grid.ColumnSpan="2" Content="Add snippet" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" Click="OnAddClick"/>
        </Grid>
        </StackPanel>
        </Border>
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Search snippets" TextChanged="OnSearchChanged" AutomationProperties.Name="Search snippets"/>
            <TextBlock x:Name="SnippetCountText" Grid.Column="1" Text="0 snippets" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
        </Grid>
        <InfoBar x:Name="StatusBar" Grid.Row="3" IsOpen="False" HorizontalAlignment="Stretch"/>
        <Grid Grid.Row="4" HorizontalAlignment="Stretch">
        <ListView x:Name="SnippetsList" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ModernCard}" Margin="0,0,0,10" Padding="16">
                        <Grid ColumnSpacing="14" RowSpacing="6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="1" Text="{Binding Text}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            <Button Grid.Column="1" Grid.RowSpan="2" Content="Copy" Tag="{Binding Text}" Click="OnCopyClick" Style="{StaticResource SecondaryButton}"/>
                            <Button Grid.Column="2" Grid.RowSpan="2" Content="Edit" Tag="{Binding Id}" Click="OnEditClick" Style="{StaticResource SecondaryButton}"/>
                            <Button Grid.Column="3" Grid.RowSpan="2" Content="Delete" Tag="{Binding Id}" Click="OnDeleteClick" Style="{StaticResource SecondaryButton}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel x:Name="EmptyState" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,28,16,0" IsHitTestVisible="False">
            <FontIcon Glyph="&#xE8C8;" FontSize="28" Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBlock x:Name="EmptyText" Text="Save time with your first snippet" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock Text="Turn a short phrase into a signature, address, or reply." Foreground="{StaticResource TextSecondaryBrush}" MaxWidth="360" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
        </Grid>
    </Grid>
</Page>
