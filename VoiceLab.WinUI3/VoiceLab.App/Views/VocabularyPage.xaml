<Page
    x:Class="VoiceLab.App.Views.VocabularyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BackgroundBrush}">
    <Grid x:Name="PageGrid" Padding="20" RowSpacing="20" MaxWidth="1040" HorizontalAlignment="Stretch" SizeChanged="OnPageSizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="Your vocabulary" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Help Echo recognize the names and words you use." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>
            <Button Grid.Column="1" Content="Manage" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top">
                <Button.Flyout><MenuFlyout>
                    <MenuFlyoutItem Text="Import words" Click="OnImportClick"/>
                    <MenuFlyoutItem Text="Export words" Click="OnExportClick"/>
                </MenuFlyout></Button.Flyout>
            </Button>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="18">
        <StackPanel Spacing="12">
        <TextBlock x:Name="EditorHeading" Text="Add a word" FontWeight="SemiBold"/>
        <Grid x:Name="WordEntryGrid" ColumnSpacing="10" RowSpacing="10" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="WordBox" PlaceholderText="e.g. VoiceLab, a name, or a technical term" KeyDown="OnWordKeyDown" AutomationProperties.Name="Word or name"/>
            <Button x:Name="SaveWordButton" Grid.Column="1" Content="Add word" Style="{StaticResource AccentButtonStyle}" Click="OnAddClick"/>
            <Button x:Name="CancelEditButton" Grid.Column="2" Content="Cancel" Style="{StaticResource SecondaryButton}" Click="OnCancelEditClick" Visibility="Collapsed"/>
        </Grid>
        <Expander x:Name="EntryOptions" Header="Language &amp; corrections" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="12">
        <StackPanel x:Name="EntryOptionsRow" Orientation="Horizontal" Spacing="16">
            <ComboBox x:Name="LanguageSelector" Header="Language" SelectedValuePath="Tag" SelectedIndex="0" MinWidth="170">
                <ComboBoxItem Content="All languages" Tag="und"/>
                <ComboBoxItem Content="Uzbek Latin" Tag="uz-Latn"/>
                <ComboBoxItem Content="Uzbek Cyrillic" Tag="uz-Cyrl"/>
                <ComboBoxItem Content="Kazakh Cyrillic" Tag="kk-Cyrl"/>
                <ComboBoxItem Content="Kazakh Latin" Tag="kk-Latn"/>
                <ComboBoxItem Content="Kyrgyz" Tag="ky-Cyrl"/>
                <ComboBoxItem Content="Tajik" Tag="tg-Cyrl"/>
                <ComboBoxItem Content="Turkmen" Tag="tk-Latn"/>
                <ComboBoxItem Content="Russian" Tag="ru-Cyrl"/>
                <ComboBoxItem Content="English" Tag="en-Latn"/>
            </ComboBox>
            <CheckBox x:Name="CorrectionCheckBox" Content="Replace a spoken word" Checked="OnCorrectionChanged"
                      Unchecked="OnCorrectionChanged" VerticalAlignment="Bottom"/>
        </StackPanel>
        <TextBox x:Name="ReplacementBox" PlaceholderText="The spelling Echo should use instead" Header="Replace with"
                 HorizontalAlignment="Stretch" Visibility="Collapsed"/>
        </StackPanel>
        </Expander>
        </StackPanel>
        </Border>
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Search vocabulary" TextChanged="OnSearchChanged" AutomationProperties.Name="Search vocabulary"/>
            <TextBlock x:Name="WordCountText" Grid.Column="1" Text="0 words" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
        </Grid>
            <Grid Grid.Row="4">
                <ListView x:Name="WordsList" SelectionMode="None">
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DisplayWord}" FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <Button Grid.Column="1" Content="Edit" Tag="{Binding Id}" Click="OnEditClick" Style="{StaticResource SecondaryButton}"/>
                                <Button Grid.Column="2" Content="Remove" Tag="{Binding Id}" Click="OnDeleteClick" Style="{StaticResource SecondaryButton}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="EmptyState" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,36,16,0" IsHitTestVisible="False">
                    <FontIcon Glyph="&#xE82D;" FontSize="28" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="EmptyText" Text="Add your first word" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock x:Name="EmptyHint" Text="Names, places, and specialist terms. Add a word above to get started." Foreground="{StaticResource TextSecondaryBrush}" MaxWidth="360" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        <InfoBar x:Name="StatusBar" Grid.Row="3" IsOpen="False" Severity="Informational" HorizontalAlignment="Stretch"/>
    </Grid>
</Page>
