<Page
    x:Class="VoiceLab.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:VoiceLab.App.Converters"
    Background="{StaticResource BackgroundBrush}">
    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="CanDeleteVisibility"/>
    </Page.Resources>
    <Grid x:Name="HistoryGrid" Padding="28" RowSpacing="18" SizeChanged="OnHistorySizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="Transcription history" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Review, search, and copy your dictations." Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>
        <Grid Grid.Row="1" RowSpacing="10" MaxWidth="960" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Search transcriptions" TextChanged="OnSearchChanged"/>
            <StackPanel x:Name="FilterActions" Grid.Row="1" Orientation="Horizontal" Spacing="10">
                <ComboBox x:Name="RangeFilter" MinWidth="170" SelectedIndex="0" SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="Any time" Tag="all"/>
                    <ComboBoxItem Content="Today" Tag="today"/>
                    <ComboBoxItem Content="Past week" Tag="week"/>
                    <ComboBoxItem Content="Past month" Tag="month"/>
                </ComboBox>
                <Button Content="Clear local copies" Click="OnClearHistoryClick" Style="{StaticResource SecondaryButton}"
                        ToolTipService.ToolTip="Removes copies saved on this PC. Account history stays available."/>
            </StackPanel>
        </Grid>
        <InfoBar x:Name="StatusBar" Grid.Row="2" IsOpen="False" MaxWidth="960" HorizontalAlignment="Left"/>
        <Grid Grid.Row="3" MaxWidth="960" HorizontalAlignment="Stretch">
            <ListView x:Name="HistoryList" SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ModernCard}" Margin="0,0,0,12" Padding="18">
                            <Grid RowSpacing="12" ColumnSpacing="20" SizeChanged="OnHistoryCardSizeChanged">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Text}" FontSize="15" TextWrapping="Wrap" MaxLines="6"/>
                                <TextBlock Text="{Binding DisplayDate}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Tag="HistoryActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Button Content="Copy" Tag="{Binding Text}" Click="OnCopyClick" Style="{StaticResource SecondaryButton}"/>
                                    <Button Content="Edit" Tag="{Binding Id}" Click="OnEditClick" Style="{StaticResource SecondaryButton}"/>
                                    <Button Content="Delete" Tag="{Binding Id}" Visibility="{Binding CanDelete, Converter={StaticResource CanDeleteVisibility}}" Click="OnDeleteClick" Style="{StaticResource SecondaryButton}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyText" Text="No transcriptions yet. Start dictating with Ctrl+Alt+Space." Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" IsHitTestVisible="False"/>
        </Grid>
        <Button x:Name="CloudLoadMoreButton" Grid.Row="4" Content="Load more from account" Click="OnLoadMoreClick"
                Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,12,0,4" Style="{StaticResource SecondaryButton}"/>
    </Grid>
</Page>
