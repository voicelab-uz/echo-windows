<Page x:Class="VoiceLab.App.Views.Onboarding.AlphabetStepPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FontFamily="{StaticResource OnbFontFamily}"
      Background="{StaticResource OnbBgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="24">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640" Spacing="22">
                <TextBlock Text="Choose your Uzbek alphabet" Style="{StaticResource OnbTitle}" TextWrapping="Wrap"/>
                <TextBlock Text="This changes how Uzbek words are inserted into other apps. Echo keeps the account transcript in its original spelling."
                           Style="{StaticResource OnbSubtitle}" TextWrapping="Wrap"/>
                <StackPanel Spacing="12" Margin="0,12,0,0">
                    <RadioButton x:Name="CurrentOption" GroupName="Alphabet" IsChecked="True" Style="{StaticResource OnbRadioButton}"
                                 HorizontalAlignment="Stretch" AutomationProperties.Name="Current Uzbek alphabet">
                        <Border Style="{StaticResource OnbCard}" MaxWidth="560" Padding="16">
                            <StackPanel Spacing="7">
                                <TextBlock Text="Current alphabet" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="O‘zbekiston, g‘oya, shahar, chiroyli" TextWrapping="Wrap"
                                           Foreground="{StaticResource OnbInkMutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </RadioButton>
                    <RadioButton x:Name="ModernOption" GroupName="Alphabet" Style="{StaticResource OnbRadioButton}"
                                 HorizontalAlignment="Stretch" AutomationProperties.Name="New Uzbek alphabet">
                        <Border Style="{StaticResource OnbCard}" MaxWidth="560" Padding="16">
                            <StackPanel Spacing="7">
                                <TextBlock Text="New alphabet" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Özbekiston, ğoya, şahar, çiroyli" TextWrapping="Wrap"
                                           Foreground="{StaticResource OnbInkMutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </RadioButton>
                </StackPanel>
                <Button Content="Continue" Style="{StaticResource OnbPrimaryButton}" Click="OnNextClick"
                        Margin="0,12,0,0" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
