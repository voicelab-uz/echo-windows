<Page x:Class="VoiceLab.App.Views.Onboarding.WelcomeStepPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FontFamily="{StaticResource OnbFontFamily}"
      Background="{StaticResource OnbBgBrush}">
    <Grid x:Name="WelcomeLayout" SizeChanged="OnLayoutSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="IntroductionColumn" Width="5*"/>
            <ColumnDefinition x:Name="PreviewColumn" Width="6*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid MinHeight="430" Padding="36,24">
                <StackPanel MaxWidth="400" Spacing="26" VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Image Source="ms-appx:///Assets/echo-icon.png" Width="34" Height="34"/>
                        <TextBlock Text="Echo" FontSize="25" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{StaticResource OnbInkBrush}"/>
                    </StackPanel>
                    <StackPanel Spacing="12">
                        <TextBlock Text="You speak.&#10;Echo writes." Style="{StaticResource OnbTitle}"
                                   FontSize="42" TextAlignment="Left" TextWrapping="Wrap"/>
                        <TextBlock Text="Turn your voice into words. In any app you work in."
                                   Style="{StaticResource OnbSubtitle}" TextAlignment="Left"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Content="Get started  →" Style="{StaticResource OnbPrimaryButton}"
                            Click="OnStartClick" HorizontalAlignment="Stretch"/>
                    <StackPanel Spacing="4">
                        <HyperlinkButton Content="Privacy policy" Tag="privacy" Click="OnLegalLinkClick"
                                         MinWidth="0" MinHeight="28" Padding="0" FontSize="12"
                                         Foreground="{StaticResource OnbInkMutedBrush}" HorizontalAlignment="Left"/>
                        <HyperlinkButton Content="Terms of Service" Tag="terms" Click="OnLegalLinkClick"
                                         MinWidth="0" MinHeight="28" Padding="0" FontSize="12"
                                         Foreground="{StaticResource OnbInkMutedBrush}" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Image x:Name="CompanyLogo" Source="ms-appx:///Assets/icons/company-logo.svg"
                               Width="48" Height="48"/>
                        <TextBlock Text="by VoiceLab" FontSize="14" VerticalAlignment="Center"
                                   Foreground="{StaticResource OnbInkMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border x:Name="PreviewPanel" Grid.Column="1" Background="{StaticResource OnbPanelBrush}"
                Padding="28" CornerRadius="0,0,16,0">
            <Grid MaxWidth="540" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="{StaticResource OnbCardBrush}"
                        BorderBrush="{StaticResource OnbCardBorderBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="0">
                    <StackPanel>
                        <Border Padding="20,14" BorderBrush="{StaticResource OnbCardBorderBrush}"
                                BorderThickness="0,0,0,1">
                            <TextBlock Text="New message" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource OnbInkBrush}"/>
                        </Border>
                        <StackPanel Spacing="18" Padding="20,20,20,34" MinHeight="190">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="28" Height="28" CornerRadius="14"
                                        Background="{StaticResource OnbPanelBrush}">
                                    <TextBlock Text="A" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                                <TextBlock Text="Aisha" VerticalAlignment="Center" FontWeight="SemiBold"
                                           Foreground="{StaticResource OnbInkBrush}"/>
                            </StackPanel>
                            <TextBlock Text="Hey Aisha,&#10;could we move our meeting to 10 tomorrow?"
                                       TextWrapping="Wrap" FontSize="18" LineHeight="28"
                                       Foreground="{StaticResource OnbInkBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="1" Spacing="14" HorizontalAlignment="Center" Margin="0,28,0,0">
                    <Border Background="{StaticResource OnbCardBrush}" CornerRadius="14"
                            BorderBrush="{StaticResource OnbCardBorderBrush}" BorderThickness="1"
                            Padding="18,12" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Image x:Name="DemoMicIcon" Source="ms-appx:///Assets/icons/mic.svg" Width="18" Height="18"/>
                            <TextBlock Text="Speak. Echo types for you." FontSize="13"
                                       Foreground="{StaticResource OnbInkBrush}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Press your shortcut · Speak · Press again"
                               FontSize="12" TextAlignment="Center"
                               Foreground="{StaticResource OnbInkMutedBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
