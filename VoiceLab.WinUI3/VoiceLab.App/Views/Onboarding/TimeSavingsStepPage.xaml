<Page
    x:Class="VoiceLab.App.Views.Onboarding.TimeSavingsStepPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FontFamily="{StaticResource OnbFontFamily}"
      Background="{StaticResource OnbBgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Padding="40">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="600"
            Spacing="32">

            <!-- Title -->
            <TextBlock Style="{StaticResource OnbTitle}"
                       TextAlignment="Center">
                <Run x:Name="MultiplierText" Text="3.2" Foreground="{StaticResource OnbAccentBrush}" FontWeight="Bold"/>
                <Run Text="x faster"/>
            </TextBlock>

            <!-- Subtitle -->
            <TextBlock Text="than average typing"
                       Style="{StaticResource OnbSubtitle}"/>

            <!-- Speed Comparison Chart -->
            <Border Style="{StaticResource OnbCard}"
                    MaxWidth="500"
                    Padding="24">
                <StackPanel Spacing="16">

                    <!-- Your Voice -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <Image x:Name="VoiceIcon" Source="ms-appx:///Assets/icons/mic.svg" Width="16" Height="16"/>
                            <TextBlock Text="Your Voice"
                                      FontSize="13"
                                      Foreground="{StaticResource OnbInkMutedBrush}"
                                      VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Grid.Column="1" Margin="12,0">
                            <Border Height="32"
                                   Background="{StaticResource OnbPanelBrush}"
                                   CornerRadius="8"/>
                            <Border x:Name="VoiceBar"
                                   Height="32"
                                   Background="{StaticResource OnbAccentBrush}"
                                   CornerRadius="8"
                                   HorizontalAlignment="Left"
                                   Width="220"/>
                        </Grid>

                        <TextBlock x:Name="VoiceWpmText"
                                  Grid.Column="2"
                                  Text="130"
                                  FontSize="13"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Average Typing -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <Image x:Name="TypingIcon" Source="ms-appx:///Assets/icons/keyboard.svg" Width="16" Height="16"/>
                            <TextBlock Text="Avg Typing"
                                      FontSize="13"
                                      Foreground="{StaticResource OnbInkMutedBrush}"
                                      VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Grid.Column="1" Margin="12,0">
                            <Border Height="32"
                                   Background="{StaticResource OnbPanelBrush}"
                                   CornerRadius="8"/>
                            <Border x:Name="TypingBar"
                                   Height="32"
                                   Background="{StaticResource OnbCardBorderBrush}"
                                   CornerRadius="8"
                                   HorizontalAlignment="Left"
                                   Width="220"/>
                        </Grid>

                        <TextBlock x:Name="TypingWpmText"
                                  Grid.Column="2"
                                  Text="40"
                                  FontSize="13"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource OnbInkMutedBrush}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- Hours Saved Calculator -->
            <Border Style="{StaticResource OnbCard}"
                    MaxWidth="500"
                    Padding="24">
                <StackPanel Spacing="16">

                    <Grid>
                        <TextBlock Text="If you type for"
                                  FontSize="14"
                                  FontWeight="Medium"
                                  VerticalAlignment="Center"/>
                        <TextBlock HorizontalAlignment="Right"
                                  FontSize="14"
                                  FontWeight="SemiBold">
                            <Run Text="{x:Bind HoursSlider.Value, Mode=OneWay}"/>
                            <Run Text=" hours/day"/>
                        </TextBlock>
                    </Grid>

                    <Slider x:Name="HoursSlider"
                           Minimum="1"
                           Maximum="8"
                           Value="2"
                           StepFrequency="1"
                           TickFrequency="1"
                           TickPlacement="BottomRight"
                           ValueChanged="OnSliderValueChanged"
                           Foreground="{StaticResource OnbAccentBrush}"/>

                    <TextBlock TextAlignment="Center"
                              FontSize="14"
                              Foreground="{StaticResource OnbInkMutedBrush}">
                        <Run Text="You'll save "/>
                        <Run x:Name="HoursSavedText"
                             Text="6.5"
                             FontSize="20"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource OnbInkBrush}"/>
                        <Run Text=" hours per week"/>
                    </TextBlock>

                </StackPanel>
            </Border>

            <!-- Next Button -->
            <Button Content="Continue"
                    Style="{StaticResource OnbPrimaryButton}"
                    Click="OnNextClick"
                    Margin="0,8,0,0"/>

        </StackPanel>
    </Grid>
    </ScrollViewer>
</Page>
