<Page
    x:Class="VoiceLab.App.Views.Onboarding.SignInStepPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FontFamily="{StaticResource OnbFontFamily}"
      Background="{StaticResource OnbBgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Padding="24">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="400"
            Spacing="32">

            <!-- Title -->
            <TextBlock Text="Sign in to VoiceLab"
                       Style="{StaticResource OnbTitle}"/>

            <!-- Subtitle -->
            <TextBlock Text="Connect your account for VoiceLab Cloud dictation"
                       Style="{StaticResource OnbSubtitle}"/>

            <!-- Sign in card -->
            <Border Style="{StaticResource OnbCard}"
                    Padding="32,24">
                <StackPanel Spacing="16">

                    <Button x:Name="SignInButton" Click="OnSignInClick"
                            HorizontalAlignment="Stretch"
                            Height="48"
                            Background="{StaticResource OnbCardBrush}"
                            BorderBrush="{StaticResource OnbCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Image Source="ms-appx:///Assets/echo-icon.png" Width="22" Height="22"/>
                            <TextBlock Text="Sign in with VoiceLab"
                                      VerticalAlignment="Center"
                                      FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <TextBlock x:Name="SignInStatus"
                               Text="Your browser will open to VoiceLab's secure sign-in page."
                               Foreground="{StaticResource OnbInkMutedBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               FontSize="12"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
    </ScrollViewer>
</Page>
