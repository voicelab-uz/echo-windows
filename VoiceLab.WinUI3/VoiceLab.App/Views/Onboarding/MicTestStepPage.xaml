<Page
    x:Class="VoiceLab.App.Views.Onboarding.MicTestStepPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FontFamily="{StaticResource OnbFontFamily}"
      Background="{StaticResource OnbBgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Padding="24">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="500"
            Spacing="32">

            <!-- Title -->
            <TextBlock Text="Test Your Microphone"
                       Style="{StaticResource OnbTitle}"/>

            <!-- Subtitle -->
            <TextBlock Text="Make sure your microphone is working properly"
                       Style="{StaticResource OnbSubtitle}"/>

            <!-- Waveform Visualization -->
            <Grid Height="120">
                <StackPanel Orientation="Horizontal"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Spacing="8">
                    <Rectangle x:Name="Bar1"
                              Width="12"
                              Height="80"
                              Fill="{StaticResource OnbAccentBrush}"
                              RadiusX="6"
                              RadiusY="6"/>
                    <Rectangle x:Name="Bar2"
                              Width="12"
                              Height="80"
                              Fill="{StaticResource OnbAccentBrush}"
                              RadiusX="6"
                              RadiusY="6"/>
                    <Rectangle x:Name="Bar3"
                              Width="12"
                              Height="80"
                              Fill="{StaticResource OnbAccentBrush}"
                              RadiusX="6"
                              RadiusY="6"/>
                    <Rectangle x:Name="Bar4"
                              Width="12"
                              Height="80"
                              Fill="{StaticResource OnbAccentBrush}"
                              RadiusX="6"
                              RadiusY="6"/>
                    <Rectangle x:Name="Bar5"
                              Width="12"
                              Height="80"
                              Fill="{StaticResource OnbAccentBrush}"
                              RadiusX="6"
                              RadiusY="6"/>
                </StackPanel>
            </Grid>

            <!-- Status -->
            <TextBlock x:Name="StatusText"
                      Text="Click test to start"
                      FontSize="14"
                      FontWeight="Medium"
                      Foreground="{StaticResource OnbInkMutedBrush}"
                      TextAlignment="Center"/>

            <!-- Test Button -->
            <Button x:Name="TestButton"
                    Content="Test Microphone"
                    Style="{StaticResource OnbPrimaryButton}"
                    Click="OnTestClick"
                    Margin="0,8,0,0"/>

            <Button x:Name="PlaybackButton"
                    Content="Play test recording"
                    Style="{StaticResource OnbSecondaryButton}"
                    Click="OnPlaybackClick"
                    IsEnabled="False"/>

            <!-- Continue Button -->
            <Button x:Name="ContinueButton" Content="Continue"
                    Style="{StaticResource OnbSecondaryButton}"
                    IsEnabled="False"
                    Click="OnNextClick"/>

        </StackPanel>
    </Grid>
    </ScrollViewer>
</Page>
