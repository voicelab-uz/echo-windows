<Page
    x:Class="VoiceLab.App.Views.Onboarding.TryItIntroStepPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FontFamily="{StaticResource OnbFontFamily}"
      Background="{StaticResource OnbBgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Padding="24">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="500"
            Spacing="32">

            <!-- Title -->
            <TextBlock Style="{StaticResource OnbTitle}"
                       TextAlignment="Center">
                <Run Text="Press "/>
                <Run x:Name="ShortcutRun" Text="Ctrl+Alt+Space" Foreground="{StaticResource OnbAccentBrush}" FontWeight="Bold"/>
                <Run Text=" to start"/>
            </TextBlock>

            <!-- Subtitle -->
            <TextBlock Text="Tap the shortcut to begin recording"
                       Style="{StaticResource OnbSubtitle}"/>

            <!-- Animated Hotkey Circle -->
            <Grid Width="160" Height="160" Margin="0,24,0,0">
                <!-- Glow Ring (pulsing) -->
                <Ellipse x:Name="GlowRing"
                        Width="160"
                        Height="160"
                        Stroke="{StaticResource OnbAccentBrush}"
                        StrokeThickness="2"
                        Opacity="0.4"/>

                <!-- Container Circle -->
                <Ellipse Width="160" Height="160"
                        Fill="{StaticResource OnbPanelBrush}"
                        Stroke="{StaticResource OnbCardBorderBrush}"
                        StrokeThickness="1"/>

                <!-- Hotkey Button (animated press) -->
                <Border x:Name="HotkeyButton"
                        Width="112"
                        Height="112"
                        Background="{StaticResource OnbKeyBrush}"
                        BorderBrush="{StaticResource OnbKeyBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Border.Shadow>
                        <ThemeShadow/>
                    </Border.Shadow>

                    <StackPanel HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Spacing="4">
                        <!-- Keyboard Icon -->
                        <Image x:Name="KeyboardIcon" Source="ms-appx:///Assets/icons/keyboard.svg"
                               Width="32" Height="32"/>

                        <!-- Shortcut Text -->
                        <TextBlock x:Name="ShortcutCaption" Text="Ctrl+Alt+Space"
                                  FontSize="11"
                                  Foreground="{StaticResource OnbInkMutedBrush}"
                                  TextAlignment="Center"
                                  FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Start Button -->
            <Button Content="Let's Try It"
                    Style="{StaticResource OnbPrimaryButton}"
                    Click="OnStartClick"
                    Margin="0,24,0,0"/>

        </StackPanel>
    </Grid>
    </ScrollViewer>
</Page>
