<Page x:Class="VoiceLab.App.Views.UploadPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource BackgroundBrush}">
    <ScrollViewer>
        <StackPanel Padding="28" Spacing="20" MaxWidth="800">
            <TextBlock Text="Transcribe an audio file" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Choose a recording. Echo will transcribe it with VoiceLab Cloud. Your device History setting controls whether a local copy is saved." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="16">
                    <Button x:Name="ChooseButton" Content="Choose audio file" Click="OnChooseClick" Style="{StaticResource SecondaryButton}"/>
                    <TextBlock x:Name="SelectedFileText" Text="No file selected" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Button x:Name="TranscribeButton" Content="Transcribe file" Click="OnTranscribeClick" Style="{StaticResource AccentButtonStyle}" IsEnabled="False"/>
                    <Button x:Name="CancelButton" Content="Cancel transcription" Click="OnCancelClick" Style="{StaticResource SecondaryButton}" Visibility="Collapsed"/>
                    <ProgressRing x:Name="BusyRing" IsActive="False" Width="28" Height="28" HorizontalAlignment="Left"/>
                    <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ModernCard}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Transcript" FontSize="17" FontWeight="SemiBold"/>
                    <TextBox x:Name="ResultText" PlaceholderText="Your transcript will appear here" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="CopyButton" Content="Copy transcript" Click="OnCopyClick" Style="{StaticResource SecondaryButton}" IsEnabled="False"/>
                        <Button x:Name="SaveNoteButton" Content="Save as note" Click="OnSaveNoteClick" Style="{StaticResource SecondaryButton}" IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
