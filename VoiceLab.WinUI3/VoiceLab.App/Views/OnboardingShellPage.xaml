<Page x:Class="VoiceLab.App.Views.OnboardingShellPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FontFamily="{StaticResource OnbFontFamily}"
      Background="{StaticResource OnbBgBrush}">
    <Grid Padding="18">
        <Border CornerRadius="18" BorderBrush="{StaticResource OnbCardBorderBrush}" BorderThickness="1"
                Background="{StaticResource OnbBgBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Padding="24,16" ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/echo-icon.png" Width="30" Height="30"/>
                        <TextBlock Text="Echo" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{StaticResource OnbInkBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="StepCountText" Grid.Column="1" Text="Step 1 of 15" FontSize="12"
                               VerticalAlignment="Center" Foreground="{StaticResource OnbInkMutedBrush}"/>
                </Grid>

                <Grid Grid.Row="1" Padding="24,8,24,12" RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="GetStartedSection" Text="01  Welcome" FontSize="11" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                    <TextBlock x:Name="PermissionsSection" Grid.Column="1" Text="02  Permissions" FontSize="11" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                    <TextBlock x:Name="SetupSection" Grid.Column="2" Text="03  Setup" FontSize="11" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                    <TextBlock x:Name="LearnSection" Grid.Column="3" Text="04  Account" FontSize="11" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                    <TextBlock x:Name="PersonalizeSection" Grid.Column="4" Text="05  Practice" FontSize="11" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                    <ProgressBar x:Name="ProgressBar" Grid.Row="1" Grid.ColumnSpan="5" Value="0" Maximum="100"
                                 Style="{StaticResource OnbProgressBar}"/>
                </Grid>

                <Frame x:Name="ContentFrame" Grid.Row="2" Navigated="OnContentNavigated"/>

                <Border Grid.Row="3" BorderBrush="{StaticResource OnbCardBorderBrush}" BorderThickness="0,1,0,0"
                        Padding="24,8">
                    <Grid>
                        <Button x:Name="BackButton" Content="&#x2190; Back" Click="OnBackClick" Visibility="Collapsed"
                                Style="{StaticResource OnbSecondaryButton}" HorizontalAlignment="Left"/>
                        <TextBlock Text="VoiceLab Echo for Windows" FontSize="11" Foreground="{StaticResource OnbInkMutedBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
