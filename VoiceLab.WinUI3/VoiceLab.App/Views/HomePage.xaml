<Page
    x:Class="VoiceLab.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource EchoPageBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="OnHomeScrollSizeChanged">
        <Grid x:Name="HomeContent" Padding="28" MaxWidth="1080" HorizontalAlignment="Left" RowSpacing="24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Spacing="6">
                <TextBlock x:Name="GreetingText" Text="Good morning" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="ShortcutHintText" Text="Your voice, ready when you are." FontSize="15" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
            <Grid x:Name="HomeStatsGrid" Grid.Row="1" ColumnSpacing="14" RowSpacing="14" SizeChanged="OnHomeStatsSizeChanged">
                <Border x:Name="HomeTranscriptionsCard" Style="{StaticResource ModernCard}">
                    <StackPanel Spacing="8"><TextBlock Text="TRANSCRIPTIONS" FontSize="11" FontWeight="SemiBold" CharacterSpacing="70" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock x:Name="TranscriptionCount" Text="0" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="HomeDataSourceText" Text="Saved on this device" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
                </Border>
                <Border x:Name="HomeWordsCard" Style="{StaticResource ModernCard}">
                    <StackPanel Spacing="8"><TextBlock Text="WORDS SPOKEN" FontSize="11" FontWeight="SemiBold" CharacterSpacing="70" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock x:Name="WordCount" Text="0" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Across your dictations" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
                </Border>
                <Border x:Name="HomeTimeCard" Style="{StaticResource ModernCard}">
                    <StackPanel Spacing="8"><TextBlock Text="TIME SAVED" FontSize="11" FontWeight="SemiBold" CharacterSpacing="70" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock x:Name="TimeSaved" Text="0 min" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Estimated from your usage" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
                </Border>
            </Grid>
            <Grid x:Name="HomeRecentHeader" Grid.Row="2" ColumnSpacing="12" RowSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Recent transcriptions" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button x:Name="ViewHistoryButton" Grid.Column="1" Content="View history" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Click="OnViewHistoryClick"/>
            </Grid>
            <Grid Grid.Row="3" MinHeight="180">
                <ItemsControl x:Name="RecentList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,12" Padding="18">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Text}" FontSize="15" TextWrapping="Wrap" MaxLines="4"/>
                                    <TextBlock Grid.Row="1" Text="{Binding DisplayDate}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                        <Button Content="Copy" Tag="{Binding Text}" Click="OnCopyClick" Style="{StaticResource SecondaryButton}"/>
                                        <Button Content="Delete" Tag="{Binding Id}" IsEnabled="{Binding CanDelete}" Click="OnDeleteClick" Style="{StaticResource SecondaryButton}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel x:Name="EmptyState" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/echo-icon.png" Width="32" Height="32" HorizontalAlignment="Center"/>
                    <TextBlock Text="Your transcriptions will show up here" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyHintText" Text="Press your shortcut to start and press it again to finish." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="430"/>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
