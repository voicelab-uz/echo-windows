<Page
    x:Class="VoiceLab.App.Views.NotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BackgroundBrush}">
    <Grid x:Name="PageGrid" Padding="28" RowSpacing="18" SizeChanged="OnPageSizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" x:Name="HeaderGrid" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Notes" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="A place for your ideas. Changes save automatically." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button x:Name="NewNoteButton" Grid.Column="1" Content="New note" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Click="OnNewNoteClick"/>
        </Grid>
        <Grid x:Name="NotesContentGrid" Grid.Row="1" ColumnSpacing="20" RowSpacing="14">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="ListCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource ModernCard}" Padding="8">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Spacing="10" Padding="6,6,6,2">
                    <Grid>
                        <TextBlock x:Name="NoteCountText" Text="Your notes" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="Folders" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Padding="9,5">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="New folder" Click="OnNewFolderClick"/>
                                    <MenuFlyoutItem x:Name="RenameFolderButton" Text="Rename selected folder" Click="OnRenameFolderClick" IsEnabled="False"/>
                                    <MenuFlyoutItem x:Name="DeleteFolderButton" Text="Delete selected folder" Click="OnDeleteFolderClick" IsEnabled="False"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <TextBox x:Name="NoteSearchBox" PlaceholderText="Search notes" TextChanged="OnSearchChanged" AutomationProperties.Name="Search notes"/>
                    <ComboBox x:Name="FolderFilter" HorizontalAlignment="Stretch" SelectionChanged="OnFolderFilterChanged" SelectedIndex="0" AutomationProperties.Name="Filter notes by folder">
                        <ComboBoxItem Content="All notes" Tag="all"/>
                        <ComboBoxItem Content="Unfiled" Tag="unfiled"/>
                    </ComboBox>
                </StackPanel>
            <TextBlock x:Name="EmptyNotesText" Grid.Row="1" Text="No notes yet. Choose New note to get started." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="14,20" Visibility="Collapsed"/>
            <ListView x:Name="NotesList" Grid.Row="1" SelectionChanged="OnNoteSelectionChanged" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="5" Padding="8,10">
                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Preview}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" MaxLines="2" TextWrapping="Wrap" TextTrimming="WordEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            </Grid>
        </Border>
        <Border x:Name="EditorCard" Grid.Row="0" Grid.Column="1" Style="{StaticResource ModernCard}">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="TitleBox" PlaceholderText="Untitled note" AutomationProperties.Name="Note title" FontSize="24" FontWeight="SemiBold" Padding="0,6" BorderThickness="0" Background="Transparent"/>
                    <Button Grid.Column="1" Content="&#xE712;" FontFamily="Segoe Fluent Icons" Width="36" Height="36" Padding="0"
                            Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Note options" ToolTipService.ToolTip="Note options">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Spacing="12" Width="240">
                                    <TextBlock Text="Note options" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="NoteFolderSelector" Header="Move to folder" HorizontalAlignment="Stretch" AutomationProperties.Name="Move note to folder">
                                        <ComboBoxItem Content="Unfiled" Tag=""/>
                                    </ComboBox>
                                    <CheckBox x:Name="PinnedCheckBox" Content="Keep at top" ToolTipService.ToolTip="Pinned notes appear first in your list"/>
                                    <Border Height="1" Background="{StaticResource EchoBorderBrush}"/>
                                    <StackPanel Spacing="6">
                                        <Button x:Name="SaveButton" Content="Save now" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButton}" Click="OnSaveClick" IsEnabled="False"/>
                                        <Button x:Name="DiscardButton" Content="Discard unsaved changes" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButton}" Click="OnDiscardClick" IsEnabled="False"/>
                                        <Button x:Name="DeleteButton" Content="Delete note" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButton}" Click="OnDeleteClick" IsEnabled="False"/>
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
                <TextBox x:Name="ContentBox" Grid.Row="1" PlaceholderText="Write or dictate your note…" AutomationProperties.Name="Note content" AcceptsReturn="True" TextWrapping="Wrap" FontSize="15" Padding="0,8" VerticalAlignment="Stretch" VerticalContentAlignment="Top" BorderThickness="0" Background="Transparent"/>
                <TextBlock x:Name="NoteStatus" Grid.Row="2" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Page>
