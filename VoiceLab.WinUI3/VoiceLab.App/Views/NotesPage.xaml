<Page
    x:Class="VoiceLab.App.Views.NotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BackgroundBrush}">
    <Grid x:Name="PageGrid" Padding="28" RowSpacing="18" SizeChanged="OnPageSizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" x:Name="HeaderGrid" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Notes" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Keep ideas and meeting notes close at hand." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button x:Name="NewNoteButton" Grid.Column="1" Content="New note" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Click="OnNewNoteClick"/>
        </Grid>
        <Grid x:Name="NotesContentGrid" Grid.Row="1" ColumnSpacing="20" RowSpacing="14">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="ListCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource ModernCard}" Padding="8">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Spacing="8" Padding="6,6,6,2">
                    <ComboBox x:Name="FolderFilter" HorizontalAlignment="Stretch" SelectionChanged="OnFolderFilterChanged" SelectedIndex="0">
                        <ComboBoxItem Content="All notes" Tag="all"/>
                        <ComboBoxItem Content="Unfiled" Tag="unfiled"/>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="New folder" Click="OnNewFolderClick" Style="{StaticResource SecondaryButton}" Padding="9,6"/>
                        <Button x:Name="RenameFolderButton" Content="Rename" Click="OnRenameFolderClick" Style="{StaticResource SecondaryButton}" Padding="9,6" IsEnabled="False"/>
                        <Button x:Name="DeleteFolderButton" Content="Delete" Click="OnDeleteFolderClick" Style="{StaticResource SecondaryButton}" Padding="9,6" IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>
            <ListView x:Name="NotesList" Grid.Row="1" SelectionChanged="OnNoteSelectionChanged" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="5" Padding="8,10">
                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Content}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" MaxLines="2" TextTrimming="WordEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            </Grid>
        </Border>
        <Border x:Name="EditorCard" Grid.Row="0" Grid.Column="1" Style="{StaticResource ModernCard}">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBox x:Name="TitleBox" PlaceholderText="Note title" FontSize="20" FontWeight="SemiBold" BorderThickness="0" Background="Transparent"/>
                <ComboBox x:Name="NoteFolderSelector" Grid.Row="1" HorizontalAlignment="Left" MinWidth="170">
                    <ComboBoxItem Content="Unfiled" Tag=""/>
                </ComboBox>
                <CheckBox x:Name="PinnedCheckBox" Grid.Row="2" Content="Pin note"/>
                <TextBox x:Name="ContentBox" Grid.Row="3" PlaceholderText="Write your note..." AcceptsReturn="True" TextWrapping="Wrap" VerticalAlignment="Stretch" VerticalContentAlignment="Top" BorderThickness="0" Background="Transparent"/>
                <Grid Grid.Row="4" RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="NoteStatus" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button x:Name="DiscardButton" Content="Discard changes" Style="{StaticResource SecondaryButton}" Click="OnDiscardClick" IsEnabled="False"/>
                        <Button x:Name="DeleteButton" Content="Delete" Style="{StaticResource SecondaryButton}" Click="OnDeleteClick" IsEnabled="False"/>
                        <Button x:Name="SaveButton" Content="Save note" Style="{StaticResource AccentButtonStyle}" Click="OnSaveClick" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Page>
