    "%@ tugmasini bosing, gapiring, tugatish uchun yana bosing." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط %@ وتحدث، ثم اضغط مجددًا للإنهاء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ চাপুন, কথা বলুন, শেষ করতে আবার চাপুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke %@, sprich und drücke erneut zum Beenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press %@, speak, then press again to finish."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa %@, habla y vuelve a pulsar para terminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur %@, parlez, puis appuyez à nouveau pour terminer."
