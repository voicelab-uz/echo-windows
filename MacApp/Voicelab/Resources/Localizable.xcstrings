    "Almashtirish matni 10 000 belgidan oshmasin." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب ألا يتجاوز النص البديل 10,000 حرف."
