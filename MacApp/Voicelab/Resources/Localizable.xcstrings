    "Yangi yozuvlar lokal tarixga saqlanmaydi. Serverdagi tarix akkaunt sozlamalariga bog‘liq." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التسجيلات الجديدة لا تُحفظ محليًا. يعتمد السجل السحابي على إعدادات الحساب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নতুন রেকর্ডিং স্থানীয়ভাবে রাখা হয় না। ক্লাউড ইতিহাস অ্যাকাউন্টের সেটিংসের উপর নির্ভর করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Aufnahmen werden nicht lokal gespeichert. Der Cloud-Verlauf hängt von deinen Kontoeinstellungen ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New recordings are not saved locally. Cloud history depends on your account settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las nuevas grabaciones no se guardan localmente. El historial en la nube depende de los ajustes de tu cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouveaux enregistrements ne sont pas conservés localement. L’historique cloud dépend des réglages du compte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नई रिकॉर्डिंग स्थानीय रूप से नहीं सहेजी जातीं। क्लाउड इतिहास खाता सेटिंग पर निर्भर है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rekaman baru tidak disimpan lokal. Riwayat cloud bergantung pada pengaturan akun."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい録音はローカルに保存されません。クラウド履歴はアカウント設定に従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 녹음은 로컬에 저장되지 않습니다. 클라우드 기록은 계정 설정에 따릅니다."
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New recordings no dey save locally. Cloud history depends on account settings."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As novas gravações não são guardadas localmente. O histórico na nuvem depende das definições da conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новые записи не сохраняются локально. История в облаке зависит от настроек аккаунта."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نئی ریکارڈنگز مقامی طور پر محفوظ نہیں ہوتیں۔ کلاؤڈ تاریخ اکاؤنٹ کی ترتیبات پر منحصر ہے۔"
