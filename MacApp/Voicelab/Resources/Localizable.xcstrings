    "Yaxshiroq ovoz uchun simli quloqchin mikrofonidan foydalaning. Bu testda audio saqlanmaydi va serverga yuborilmaydi." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لصوت أفضل، استخدم ميكروفون سماعة سلكية. الاختبار لا يحفظ الصوت ولا يرفعه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভালো শব্দের জন্য তারযুক্ত হেডসেট মাইক্রোফোন ব্যবহার করুন। এই পরীক্ষায় অডিও রাখা বা পাঠানো হয় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze ein kabelgebundenes Headset für besseren Ton. Dieser Test speichert und sendet kein Audio."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For better audio, use a wired headset microphone. This test does not save or upload audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para mejorar el sonido, usa auriculares con cable y micrófono. Esta prueba no guarda ni envía audio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour un meilleur son, utilisez un casque filaire avec micro. Ce test ne conserve ni n’envoie d’audio."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बेहतर आवाज़ के लिए तार वाला हेडसेट माइक्रोफ़ोन इस्तेमाल करें। परीक्षण ऑडियो न सहेजता है न भेजता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk suara lebih baik, gunakan mikrofon headset berkabel. Tes ini tidak menyimpan atau mengunggah audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音質向上には有線ヘッドセットのマイクをご利用ください。このテストでは音声を保存・送信しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 좋은 음질을 위해 유선 헤드셋 마이크를 사용하세요. 이 테스트는 오디오를 저장하거나 전송하지 않습니다."
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use wired headset microphone for better sound. This test no dey save or upload audio."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para melhor áudio, use auscultadores com microfone e fio. Este teste não guarda nem envia áudio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для лучшего звука используйте проводную гарнитуру. Во время проверки аудио не сохраняется и не отправляется на сервер."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بہتر آواز کے لیے تار والا ہیڈسیٹ مائیکروفون استعمال کریں۔ یہ ٹیسٹ آڈیو محفوظ یا اپ لوڈ نہیں کرتا۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaxshiroq ovoz uchun simli quloqchin mikrofonidan foydalaning. Bu testda audio saqlanmaydi va serverga yuborilmaydi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用有线耳麦可改善音质。此测试不会保存或上传音频。"
          }
        }
      }
    },
