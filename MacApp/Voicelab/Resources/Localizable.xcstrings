    },
    "Hisobingizdagi saqlangan yozuvlar asosida. O‘chirilgan yozuvlar hisoblanmaydi." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعتمد على السجل المحفوظ في الحساب. لا يشمل التسجيلات المحذوفة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাকাউন্টের রাখা ইতিহাসের ভিত্তিতে। মুছে ফেলা রেকর্ডিং বাদ।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basierend auf gespeichertem Kontoverlauf. Gelöschte Aufnahmen sind ausgeschlossen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Based on retained account history. Deleted recordings are excluded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basado en el historial conservado de la cuenta. Excluye grabaciones eliminadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basé sur l’historique conservé du compte. Enregistrements supprimés exclus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खाते में बचे इतिहास के आधार पर। मिटाई गई रिकॉर्डिंग शामिल नहीं हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berdasarkan riwayat akun yang tersimpan. Rekaman terhapus tidak dihitung."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存済みのアカウント履歴に基づきます。削除済みの録音は含みません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정에 보관된 기록 기준입니다. 삭제한 녹음은 제외됩니다."
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
