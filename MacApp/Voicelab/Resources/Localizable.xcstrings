    "Echo menyu panelida turadi. Tarix va sozlamalarni ko‘rish uchun istalgan vaqt oching." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى Echo في شريط القوائم. افتحه متى شئت للسجل والإعدادات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo মেনু বারে থাকে। ইতিহাস ও সেটিংসের জন্য যেকোনো সময় খুলুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo bleibt in der Menüleiste. Öffne es jederzeit für Verlauf und Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo stays in the menu bar. Open it any time for history and settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo permanece en la barra de menús. Ábrelo para ver el historial y los ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo reste dans la barre des menus. Ouvrez-le pour consulter l’historique et les réglages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo मेनू बार में रहता है। इतिहास और सेटिंग के लिए कभी भी खोलें।"
          }
