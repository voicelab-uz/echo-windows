    "Echo ishlayotganida Fn’ning emoji amali vaqtincha o‘chiriladi. Ilovadan chiqqanda oldingi sozlama qaytariladi." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُعطّل إجراء الرموز التعبيرية لمفتاح Fn مؤقتًا أثناء تشغيل Echo. يعود الإعداد السابق عند الإنهاء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo চলার সময় Fn-এর ইমোজি কাজ সাময়িক বন্ধ থাকে। অ্যাপ বন্ধ করলে আগের সেটিং ফেরে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solange Echo läuft, ist die Emoji-Aktion von Fn deaktiviert. Beim Beenden wird die vorherige Einstellung wiederhergestellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While Echo is running, Fn's emoji action is temporarily disabled. Your previous setting returns when you quit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras Echo está abierto, la acción de emojis de Fn se desactiva. Al salir se restaura el ajuste anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant qu’Echo fonctionne, l’action emoji de Fn est désactivée. Le réglage précédent est restauré en quittant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo चलने पर Fn का इमोजी काम अस्थायी रूप से बंद रहता है। बंद करने पर पुरानी सेटिंग लौट आती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat Echo berjalan, aksi emoji Fn dinonaktifkan sementara. Pengaturan sebelumnya kembali saat keluar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echoの起動中はFnの絵文字操作が一時的に無効になります。終了時に元の設定に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo 실행 중에는 Fn의 이모지 동작이 일시 중지됩니다. 종료하면 이전 설정으로 돌아갑니다."
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While Echo dey run, Fn emoji action go pause. Your old setting go return when you quit."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquanto o Echo estiver aberto, a ação de emojis da tecla Fn fica desativada. A definição anterior regressa ao sair."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока Echo работает, вызов эмодзи через Fn временно отключён. При выходе прежняя настройка восстанавливается."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo چلنے پر Fn کا ایموجی عمل عارضی طور پر بند رہتا ہے۔ ایپ بند ہونے پر پرانی ترتیب واپس آتی ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo ishlayotganida Fn’ning emoji amali vaqtincha o‘chiriladi. Ilovadan chiqqanda oldingi sozlama qaytariladi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo 运行时会暂时禁用 Fn 的表情操作。退出后恢复原设置。"
          }
        }
      }
    },
