          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo는 당신의 단어를 당신 방식대로 씁니다."
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
