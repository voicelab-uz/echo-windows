    "Let Echo notify you when an update is available or ready to install." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let Echo notify you when an update is available or ready to install."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yangilanish mavjud yoki o‘rnatishga tayyor bo‘lganda Echo sizga xabar bersin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo сообщит, когда обновление доступно или готово к установке."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo informiert dich, wenn ein Update verfügbar oder bereit zur Installation ist."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업데이트가 있거나 설치 준비가 되면 Echo가 알려 드립니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有可用更新或更新准备好安装时，让 Echo 通知你。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपडेट उपलब्ध होने या इंस्टॉल करने के लिए तैयार होने पर Echo आपको बताए।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo te avisará cuando haya una actualización disponible o lista para instalar."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح لـ Echo بإشعارك عندما يتوفر تحديث أو يصبح جاهزًا للتثبيت."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo vous prévient lorsqu’une mise à jour est disponible ou prête à être installée."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপডেট পাওয়া গেলে বা ইনস্টল করার জন্য প্রস্তুত হলে Echo আপনাকে জানাবে।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Echo avisa quando uma atualização estiver disponível ou pronta para instalar."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo memberi tahu saat pembaruan tersedia atau siap dipasang."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپ ڈیٹ دستیاب ہونے یا انسٹال کے لیے تیار ہونے پر Echo آپ کو مطلع کرے۔"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップデートが利用可能になったり、インストールの準備ができたりしたら Echo が通知します。"
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make Echo tell you when update dey available or ready to install."
          }
        }
      }
    },
    "Open Echo to review the update. Your work will stay protected." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Echo to review the update. Your work will stay protected."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yangilanishni ko‘rish uchun Echo’ni oching. Ishingiz himoyalangan holda qoladi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте Echo, чтобы посмотреть обновление. Ваша работа останется защищённой."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne Echo, um das Update anzusehen. Deine Arbeit bleibt geschützt."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo를 열어 업데이트를 확인하세요. 작업 내용은 안전하게 보호됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开 Echo 查看更新。你的工作将受到保护。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपडेट देखने के लिए Echo खोलें। आपका काम सुरक्षित रहेगा।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Echo para revisar la actualización. Tu trabajo estará protegido."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح Echo لمراجعة التحديث. سيبقى عملك محميًا."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Echo pour consulter la mise à jour. Votre travail restera protégé."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপডেটটি দেখতে Echo খুলুন। আপনার কাজ সুরক্ষিত থাকবে।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra o Echo para conferir a atualização. Seu trabalho continuará protegido."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka Echo untuk melihat pembaruan. Pekerjaan Anda tetap terlindungi."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپ ڈیٹ دیکھنے کے لیے Echo کھولیں۔ آپ کا کام محفوظ رہے گا۔"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo を開いてアップデートを確認してください。作業内容は保護されます。"
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Echo to check the update. Your work go remain safe."
          }
        }
      }
    },
    "Could not show the update notification. Updates are still available in Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not show the update notification. Updates are still available in Settings."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yangilanish bildirishnomasini ko‘rsatib bo‘lmadi. Yangilanishlar Sozlamalarda mavjud."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось показать уведомление об обновлении. Обновления по-прежнему доступны в настройках."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Update-Mitteilung konnte nicht angezeigt werden. Updates sind weiterhin in den Einstellungen verfügbar."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업데이트 알림을 표시하지 못했습니다. 설정에서 업데이트를 확인할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法显示更新通知。你仍可在设置中查看更新。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपडेट सूचना नहीं दिखाई जा सकी। अपडेट अभी भी सेटिंग्स में उपलब्ध हैं।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo mostrar la notificación. Las actualizaciones siguen disponibles en Ajustes."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر عرض إشعار التحديث. لا تزال التحديثات متاحة في الإعدادات."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’afficher la notification. Les mises à jour restent disponibles dans les réglages."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপডেট বিজ্ঞপ্তি দেখানো যায়নি। সেটিংসে আপডেট এখনও পাওয়া যাবে।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível mostrar a notificação. As atualizações continuam disponíveis nos Ajustes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikasi pembaruan tidak dapat ditampilkan. Pembaruan tetap tersedia di Pengaturan."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپ ڈیٹ کی اطلاع نہیں دکھائی جا سکی۔ اپ ڈیٹس اب بھی ترتیبات میں دستیاب ہیں۔"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップデート通知を表示できませんでした。設定から引き続きアップデートを確認できます。"
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update notification no show. You fit still find updates for Settings."
          }
        }
