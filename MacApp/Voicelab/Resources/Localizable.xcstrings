        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残り時間を更新できませんでした。更新して再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "남은 시간을 업데이트하지 못했습니다. 새로고침하여 다시 시도하세요."
