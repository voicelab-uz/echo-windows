    "Boshqa tugmani tanlang. Harf va raqamlar uchun ⌘, ⌥ yoki ⌃ kerak; tizim tugmalari band." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر مفتاحًا آخر. تحتاج الحروف والأرقام إلى ⌘ أو ⌥ أو ⌃؛ اختصارات النظام محجوزة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অন্য একটি কী বেছে নিন। অক্ষর ও সংখ্যার জন্য ⌘, ⌥ বা ⌃ লাগবে; সিস্টেম শর্টকাট সংরক্ষিত।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine andere Taste. Buchstaben und Zahlen brauchen ⌘, ⌥ oder ⌃; Systemkürzel sind reserviert."
          }
        },
        "en" : {
