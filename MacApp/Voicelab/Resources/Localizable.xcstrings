    "Qayd hajmi juda katta yoki yaroqsiz belgi mavjud. Lokal nusxa saqlangan." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الملاحظة كبيرة أو تحتوي حرفًا غير مدعوم. حُفظت نسخة محلية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নোটটি খুব বড় বা অসমর্থিত অক্ষর আছে। স্থানীয় কপি রাখা হয়েছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Notiz ist zu groß oder enthält ungültige Zeichen. Eine lokale Kopie ist gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The note is too large or contains an unsupported character. A local copy is saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nota es demasiado grande o tiene un carácter incompatible. Se conserva una copia local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note trop volumineuse ou caractère non pris en charge. Une copie locale est conservée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नोट बहुत बड़ा है या उसमें असमर्थित अक्षर है। स्थानीय प्रति सहेजी गई है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catatan terlalu besar atau berisi karakter tidak didukung. Salinan lokal tersimpan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモが大きすぎるか未対応の文字を含んでいます。ローカルコピーは保存済みです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모가 너무 크거나 지원하지 않는 문자가 있습니다. 로컬 사본을 저장했습니다."
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note too big or e get character wey we no support. Local copy don save."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nota é demasiado grande ou contém um carácter não suportado. Foi guardada uma cópia local."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заметка слишком большая или содержит недопустимый символ. Локальная копия сохранена."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نوٹ بہت بڑا ہے یا اس میں غیر معاون حرف ہے۔ مقامی نقل محفوظ ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qayd hajmi juda katta yoki yaroqsiz belgi mavjud. Lokal nusxa saqlangan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "笔记太大或包含不支持的字符。本地副本已保存。"
          }
        }
      }
    },
