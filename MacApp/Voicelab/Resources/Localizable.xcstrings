    "Mikrofonga ruxsat kerak. System Settings → Privacy & Security → Microphone bo‘limida Echo’ni yoqing." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يلزم إذن الميكروفون. فعّل Echo في إعدادات النظام ← الخصوصية والأمان ← الميكروفون."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মাইক্রোফোনের অনুমতি প্রয়োজন। সিস্টেম সেটিংস → গোপনীয়তা ও নিরাপত্তা → মাইক্রোফোনে Echo চালু করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofonzugriff erforderlich. Aktiviere Echo unter Systemeinstellungen → Datenschutz & Sicherheit → Mikrofon."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microphone permission is required. Enable Echo in System Settings → Privacy & Security → Microphone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita permiso de micrófono. Activa Echo en Ajustes del Sistema → Privacidad y seguridad → Micrófono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accès au microphone requis. Activez Echo dans Réglages Système → Confidentialité et sécurité → Microphone."
