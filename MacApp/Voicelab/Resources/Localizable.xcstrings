    "Server belgilagan kutish vaqti tugagach davom etishingiz mumkin." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك المتابعة بعد انتهاء مدة انتظار الخادم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সার্ভারের অপেক্ষার সময় শেষ হলে এগোতে পারবেন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach Ablauf der Server-Wartezeit kannst du fortfahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can continue when the server's waiting period ends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podrás continuar cuando termine el tiempo de espera del servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pourrez continuer après le délai imposé par le serveur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्वर की प्रतीक्षा अवधि खत्म होने पर जारी रख सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda bisa melanjutkan setelah waktu tunggu server berakhir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーの待ち時間が終わると続行できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버 대기 시간이 끝나면 계속할 수 있습니다."
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You fit continue when server waiting time finish."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode continuar quando terminar o tempo de espera do servidor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продолжить можно после окончания времени ожидания сервера."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سرور کا انتظار ختم ہونے پر جاری رکھ سکتے ہیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server belgilagan kutish vaqti tugagach davom etishingiz mumkin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器等待时间结束后即可继续。"
          }
        }
