    "Global shortcut uchun System Settings → Privacy & Security → Accessibility bo‘limida Echo’ni yoqing." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فعّل Echo في إعدادات النظام ← الخصوصية والأمان ← تسهيلات الاستخدام لتفعيل الاختصار العام."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "গ্লোবাল শর্টকাটের জন্য সিস্টেম সেটিংস → গোপনীয়তা ও নিরাপত্তা → অ্যাক্সেসিবিলিটিতে Echo চালু করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere Echo unter Systemeinstellungen → Datenschutz & Sicherheit → Bedienungshilfen für das globale Tastenkürzel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable Echo in System Settings → Privacy & Security → Accessibility to use the global shortcut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Echo en Ajustes del Sistema → Privacidad y seguridad → Accesibilidad para usar el atajo global."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Echo dans Réglages Système → Confidentialité et sécurité → Accessibilité pour utiliser le raccourci global."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ग्लोबल शॉर्टकट के लिए सिस्टम सेटिंग → गोपनीयता और सुरक्षा → सुलभता में Echo चालू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktifkan Echo di Pengaturan Sistem → Privasi & Keamanan → Aksesibilitas untuk pintasan global."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グローバルショートカットには、システム設定 → プライバシーとセキュリティ → アクセシビリティでEchoを有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전역 단축키를 사용하려면 시스템 설정 → 개인정보 보호 및 보안 → 손쉬운 사용에서 Echo를 켜세요."
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable Echo for System Settings → Privacy & Security → Accessibility to use global shortcut."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o Echo em Definições do Sistema → Privacidade e Segurança → Acessibilidade para usar o atalho global."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для глобального сочетания клавиш включите Echo в System Settings → Privacy & Security → Accessibility."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شارٹ کٹ کے لیے سسٹم سیٹنگز ← رازداری اور تحفظ ← رسائی میں Echo فعال کریں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Global shortcut uchun System Settings → Privacy & Security → Accessibility bo‘limida Echo’ni yoqing."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“系统设置 → 隐私与安全性 → 辅助功能”中启用 Echo，以使用全局快捷键。"
