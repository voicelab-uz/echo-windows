    "Akkauntingiz va yozuvlaringiz saqlanib qoladi." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم الاحتفاظ بحسابك وتسجيلاتك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার অ্যাকাউন্ট ও রেকর্ডিং অক্ষত থাকবে।"
