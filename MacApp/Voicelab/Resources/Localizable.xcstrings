    "Iboralar saqlanib qoladi. Bu amalni bekor qilib bo‘lmaydi." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستبقى مقتطفاتك محفوظة. لا يمكن التراجع."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বাক্যাংশগুলো রাখা হবে। এই কাজ ফেরানো যাবে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Textbausteine bleiben erhalten. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your snippets will be kept. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus fragmentos se conservarán. Esto no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos extraits seront conservés. Cette action est irréversible."
