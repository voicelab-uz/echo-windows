    "Ishonchingiz uchun rahmat.\nMaxfiyligingiz biz uchun muhim." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شكرًا لثقتك.\nخصوصيتك تهمنا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার আস্থার জন্য ধন্যবাদ।\nআপনার গোপনীয়তা আমাদের কাছে গুরুত্বপূর্ণ।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danke für dein Vertrauen.\nDeine Privatsphäre ist uns wichtig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thank you for your trust.\nYour privacy matters to us."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gracias por tu confianza.\nTu privacidad nos importa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merci de votre confiance.\nVotre confidentialité nous tient à cœur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके भरोसे के लिए धन्यवाद।\nआपकी गोपनीयता हमारे लिए अहम है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terima kasih atas kepercayaan Anda.\nPrivasi Anda penting bagi kami."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ご信頼ありがとうございます。\nプライバシーを大切にしています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "믿어 주셔서 감사합니다.\n개인정보를 소중히 지킵니다."
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thanks for trusting us.\nYour privacy matter to us."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrigado pela confiança.\nA sua privacidade é importante para nós."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спасибо за доверие.\nВаша конфиденциальность важна для нас."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے اعتماد کا شکریہ۔\nآپ کی رازداری ہمارے لیے اہم ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ishonchingiz uchun rahmat.\nMaxfiyligingiz biz uchun muhim."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感谢您的信任。\n我们重视您的隐私。"
          }
        }
      }
    },
