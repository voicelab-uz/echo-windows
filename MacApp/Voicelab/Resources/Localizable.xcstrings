    "Boshqa kombinatsiyani tanlang. Kamida ⌘, ⌥ yoki ⌃ kerak; tizim tugmalari band." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر تركيبة تضم ⌘ أو ⌥ أو ⌃. اختصارات النظام القياسية محجوزة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘, ⌥ বা ⌃-সহ অন্য সমন্বয় বেছে নিন। সাধারণ সিস্টেম শর্টকাট সংরক্ষিত।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Kombination mit ⌘, ⌥ oder ⌃. Standard-Systemkürzel sind reserviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose another combination. Include ⌘, ⌥ or ⌃; standard system shortcuts are reserved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige otra combinación con ⌘, ⌥ o ⌃. Los atajos estándar del sistema están reservados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une combinaison avec ⌘, ⌥ ou ⌃. Les raccourcis système standard sont réservés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘, ⌥ या ⌃ वाला दूसरा संयोजन चुनें। सामान्य सिस्टम शॉर्टकट आरक्षित हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih kombinasi dengan ⌘, ⌥, atau ⌃. Pintasan sistem standar dicadangkan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘、⌥または⌃を含む別の組み合わせを選んでください。標準のシステムショートカットは使用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘, ⌥ 또는 ⌃를 포함한 다른 조합을 선택하세요. 기본 시스템 단축키는 사용할 수 없습니다."
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose another combination with ⌘, ⌥ or ⌃. System shortcuts don get their own work."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha outra combinação com ⌘, ⌥ ou ⌃. Os atalhos padrão do sistema estão reservados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите другое сочетание с ⌘, ⌥ или ⌃. Стандартные системные сочетания заняты."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘، ⌥ یا ⌃ والا دوسرا مجموعہ منتخب کریں۔ عام سسٹم شارٹ کٹس مخصوص ہیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boshqa kombinatsiyani tanlang. Kamida ⌘, ⌥ yoki ⌃ kerak; tizim tugmalari band."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请选择包含 ⌘、⌥ 或 ⌃ 的其他组合。系统默认快捷键已保留。"
          }
        }
      }
    },
    "Boshqa qurilmadagi tahrir ham saqlandi. Qaydlar ro‘yxatini tekshiring." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حُفظ تعديل الجهاز الآخر أيضًا. راجع قائمة الملاحظات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অন্য ডিভাইসের সম্পাদনাও রাখা হয়েছে। নোটের তালিকা দেখুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bearbeitung vom anderen Gerät wurde ebenfalls gespeichert. Prüfe deine Notizen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The edit from the other device was preserved too. Check your notes list."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También se conservó la edición del otro dispositivo. Revisa tus notas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modification de l’autre appareil a aussi été conservée. Vérifiez vos notes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दूसरे डिवाइस का संपादन भी सुरक्षित है। नोट्स की सूची देखें।"
