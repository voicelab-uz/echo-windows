    "Oddiy gapiring. Echo so‘zlaringizni kursor turgan joyga toza matn qilib yozadi: xabarlar, xatlar, hujjatlar va boshqalar." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحدث طبيعيًا. يُدرج Echo نصًا عند المؤشر: رسائل وبريد ومستندات وغيرها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্বাভাবিকভাবে বলুন। Echo কার্সরের জায়গায় বার্তা, ইমেইল, নথি ও অন্যান্য লেখা বসায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprich natürlich. Echo fügt Text am Cursor ein: Nachrichten, E-Mails, Dokumente und mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speak naturally. Echo inserts clean text wherever your cursor is: messages, emails, documents and more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habla con naturalidad. Echo inserta texto donde está el cursor: mensajes, correos, documentos y más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parlez naturellement. Echo insère du texte à l’emplacement du curseur : messages, emails, documents et plus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वाभाविक बोलें। Echo कर्सर की जगह संदेश, ईमेल, दस्तावेज़ और अन्य टेक्स्ट लिखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bicara alami. Echo menyisipkan teks di posisi kursor: pesan, email, dokumen, dan lainnya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自然に話すだけ。Echoがカーソル位置にメッセージ、メール、文書などのテキストを入力します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자연스럽게 말하세요. Echo가 커서 위치에 메시지, 이메일, 문서 등의 텍스트를 입력합니다."
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talk normally. Echo puts clean text where your cursor dey: messages, emails, documents and more."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fale naturalmente. O Echo insere texto onde estiver o cursor: mensagens, emails, documentos e muito mais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Говорите свободно. Echo вставит текст туда, где стоит курсор: в сообщения, письма, документы и не только."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قدرتی انداز سے بولیں۔ Echo کرسر کی جگہ پیغامات، ای میل، دستاویزات اور دیگر متن لکھتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oddiy gapiring. Echo so‘zlaringizni kursor turgan joyga toza matn qilib yozadi: xabarlar, xatlar, hujjatlar va boshqalar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自然地说话。Echo 会在光标处插入文本：消息、邮件、文档等。"
          }
        }
      }
    },
