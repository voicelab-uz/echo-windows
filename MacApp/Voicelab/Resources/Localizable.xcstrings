    "Yangilash amalga oshmadi. Oxirgi olingan ma’lumot ko‘rsatilmoqda." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر التحديث. تُعرض آخر بيانات متاحة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "রিফ্রেশ হয়নি। সর্বশেষ পাওয়া তথ্য দেখানো হচ্ছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisierung fehlgeschlagen. Die zuletzt verfügbaren Daten werden angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not refresh. Showing the last available data."
          }
        },
        "es" : {
