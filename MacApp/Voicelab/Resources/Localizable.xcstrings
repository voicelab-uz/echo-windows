    "Tugmani bosib turib gapiring, qo‘yib yuborsangiz yozuv tugaydi." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مع الاستمرار وتحدث، وعند الإفلات ينتهي التسجيل."
          }
