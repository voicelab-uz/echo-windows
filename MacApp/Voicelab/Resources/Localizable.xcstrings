    "Mavzu almashtirilganda paydo bo‘ladigan ingichka chiziqlar tuzatildi." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إصلاح الخطوط الرفيعة التي كانت تظهر عند تبديل المظهر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "থিম বদলানোর সময় দেখা দেওয়া সরু রেখা ঠিক করা হয়েছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feine Linien beim Wechsel des Erscheinungsbilds wurden behoben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixed thin lines that appeared when switching themes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se corrigieron las líneas finas que aparecían al cambiar de tema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correction des fines lignes qui apparaissaient en changeant de thème."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "थीम बदलते समय दिखने वाली पतली रेखाएँ ठीक की गईं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memperbaiki garis tipis yang muncul saat mengganti tema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テーマ切り替え時に出ていた細い線を修正しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "테마 전환 시 나타나던 얇은 선을 수정했습니다."
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We fix thin lines wey dey show when you change theme."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrigidas as linhas finas que apareciam ao trocar de tema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Исправлены тонкие линии при смене темы."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تھیم بدلتے وقت نظر آنے والی باریک لکیریں درست کی گئیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mavzu almashtirilganda paydo bo‘ladigan ingichka chiziqlar tuzatildi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修复了切换主题时出现的细线。"
          }
        }
      }
    },
