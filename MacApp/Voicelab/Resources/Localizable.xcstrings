    "Joriy tarifingizdagi ovozli yozish vaqti tugadi. Ko‘proq vaqt olish uchun yuqoriroq tarifga o‘ting." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقد استنفدت وقت الإملاء في خطتك الحالية. انتقل إلى خطة أعلى للحصول على مزيد من الوقت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার বর্তমান প্ল্যানের ডিকটেশনের সময় শেষ হয়েছে। আরও সময় পেতে উচ্চতর প্ল্যানে আপগ্রেড করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Diktierzeit im aktuellen Tarif ist aufgebraucht. Wechsle zu einem höheren Tarif, um mehr Zeit zu erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You’ve used all the dictation time in your current plan. Upgrade to a higher plan to get more time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has agotado el tiempo de dictado de tu plan actual. Pasa a un plan superior para obtener más tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez utilisé tout le temps de dictée de votre offre actuelle. Passez à une offre supérieure pour obtenir plus de temps."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके मौजूदा प्लान का डिक्टेशन समय समाप्त हो गया है। अधिक समय पाने के लिए ऊँचे प्लान पर अपग्रेड करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waktu dikte pada paket Anda saat ini sudah habis. Tingkatkan ke paket yang lebih tinggi untuk mendapatkan lebih banyak waktu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のプランの音声入力時間を使い切りました。上位プランにアップグレードすると、利用時間を増やせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 요금제의 받아쓰기 시간을 모두 사용했습니다. 더 많은 시간을 이용하려면 상위 요금제로 업그레이드하세요."
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You don use all the dictation time for your current plan. Upgrade to higher plan to get more time."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você usou todo o tempo de ditado do seu plano atual. Mude para um plano superior para ter mais tempo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время диктовки по вашему текущему тарифу закончилось. Перейдите на более высокий тариф, чтобы получить больше времени."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے موجودہ پلان کا ڈکٹیشن وقت ختم ہو گیا ہے۔ مزید وقت حاصل کرنے کے لیے اعلیٰ پلان پر اپ گریڈ کریں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joriy tarifingizdagi ovozli yozish vaqti tugadi. Ko‘proq vaqt olish uchun yuqoriroq tarifga o‘ting."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前套餐的听写时长已用完。升级到更高套餐可获得更多时长。"
