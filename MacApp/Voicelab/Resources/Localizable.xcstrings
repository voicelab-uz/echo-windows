    "Tez-tez yoziladigan matnni saqlang — email, tanishtiruv yoki prompt — keyin bir iborani aytib, uni darhol qo‘ying." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احفظ النص الذي تكتبه كثيرًا — بريد أو تعريف أو موجّه — ثم قل كلمة لإدراجه فورًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যা প্রায়ই লেখেন তা সংরক্ষণ করুন — ইমেইল, পরিচিতি বা প্রম্পট — তারপর একটি শব্দ বলে সাথে সাথে বসান।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichern Sie oft getippten Text – eine E-Mail, eine Vorstellung oder einen Prompt – und fügen Sie ihn mit einem Wort sofort ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save text you type often — an email, intro, or prompt — then say a word to drop it in instantly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda el texto que escribes a menudo —un correo, una presentación o un prompt— y di una palabra para insertarlo al instante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez un texte que vous tapez souvent — un e-mail, une présentation ou un prompt — puis dites un mot pour l’insérer aussitôt."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अक्सर लिखा जाने वाला टेक्स्ट सहेजें — ईमेल, परिचय या प्रॉम्प्ट — फिर एक शब्द बोलकर उसे तुरंत डालें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan teks yang sering Anda ketik — email, perkenalan, atau prompt — lalu ucapkan satu kata untuk menyisipkannya seketika."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "よく打つテキスト（メール、自己紹介、プロンプトなど）を保存し、一言話すだけですぐに入力できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자주 입력하는 텍스트(이메일, 소개, 프롬프트)를 저장해 두고 한 단어만 말하면 바로 입력됩니다."
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save text wey you dey type often — email, intro or prompt — then talk one word make e enter sharp sharp."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde o texto que escreve com frequência — um e-mail, uma apresentação ou um prompt — e diga uma palavra para o inserir de imediato."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраните текст, который часто набираете, — письмо, представление или промпт, — и вставляйте его одним словом."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اکثر لکھا جانے والا متن محفوظ کریں — ای میل، تعارف یا پرامپٹ — پھر ایک لفظ کہہ کر فوراً ڈالیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tez-tez yoziladigan matnni saqlang — email, tanishtiruv yoki prompt — keyin bir iborani aytib, uni darhol qo‘ying."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存常打的文字——邮件、自我介绍或提示词——说一个词就能立即插入。"
          }
        }
      }
    },
