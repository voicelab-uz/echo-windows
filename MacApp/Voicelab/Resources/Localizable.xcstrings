    "Daqiqalar ma’lumotini yangilab bo‘lmadi. Qayta yangilang." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر تحديث الدقائق المتبقية. حدّث للمحاولة مجددًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বাকি মিনিট আপডেট করা যায়নি। রিফ্রেশ করে আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbleibende Minuten konnten nicht aktualisiert werden. Versuche es erneut."
          }
