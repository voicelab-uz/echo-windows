    "Kompyuteringizdagi ovozli yozuvni tanlang.\nEcho uni o‘qish va nusxalash uchun tayyorlaydi." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر تسجيلًا من حاسوبك.\nسيحوّله Echo إلى نص يمكنك قراءته ونسخه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কম্পিউটার থেকে রেকর্ডিং বেছে নিন।\nEcho এটিকে পড়া ও কপি করার মতো লেখা বানাবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Aufnahme von deinem Computer.\nEcho macht daraus lesbaren und kopierbaren Text."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a recording from your computer.\nEcho will turn it into text you can read and copy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una grabación de tu ordenador.\nEcho la convertirá en texto para leer y copiar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un enregistrement sur votre ordinateur.\nEcho en fera un texte à lire et à copier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कंप्यूटर से रिकॉर्डिंग चुनें।\nEcho इसे पढ़ने और कॉपी करने योग्य टेक्स्ट बनाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih rekaman dari komputer.\nEcho mengubahnya menjadi teks yang bisa dibaca dan disalin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンピュータから録音を選んでください。\nEchoが読み取り・コピーできるテキストにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴퓨터의 녹음을 선택하세요.\nEcho가 읽고 복사할 수 있는 텍스트로 만듭니다."
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose recording from your computer.\nEcho go turn am to text wey you fit read and copy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma gravação do computador.\nO Echo transforma-a em texto para ler e copiar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите запись на компьютере.\nEcho подготовит текст для чтения и копирования."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کمپیوٹر سے ریکارڈنگ منتخب کریں۔\nEcho اسے پڑھنے اور نقل کرنے کے قابل متن بنائے گا۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompyuteringizdagi ovozli yozuvni tanlang.\nEcho uni o‘qish va nusxalash uchun tayyorlaydi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择电脑上的录音。\nEcho 会将其转为可阅读和复制的文本。"
          }
        }
      }
    },
