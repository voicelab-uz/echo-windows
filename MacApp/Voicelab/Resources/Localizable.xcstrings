    "Bosib turib gapiring yoki ikki marta bosib qo‘lsiz yozing. To‘xtatish uchun yana bosing." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مع الاستمرار للتحدث، أو اضغط مرتين للتسجيل دون استخدام اليدين. اضغط مرة أخرى للإيقاف."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চেপে ধরে কথা বলুন, অথবা হ্যান্ডস-ফ্রি রেকর্ডিংয়ের জন্য দুবার চাপুন। থামাতে আবার চাপুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gedrückt halten zum Sprechen oder doppelt tippen für freihändige Aufnahme. Zum Beenden erneut drücken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold to talk, or double-tap for hands-free. Press again to stop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado para hablar o pulsa dos veces para grabar sin manos. Vuelve a pulsar para detener."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez pour parler, ou appuyez deux fois pour dicter mains libres. Appuyez à nouveau pour arrêter."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बोलने के लिए दबाए रखें, या हैंड्स-फ़्री के लिए दो बार दबाएँ। रोकने के लिए फिर से दबाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahan untuk bicara, atau ketuk dua kali untuk mode bebas genggam. Tekan lagi untuk berhenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "押し続けて話すか、2回押してハンズフリーで録音します。もう一度押すと停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "길게 눌러 말하거나 두 번 눌러 핸즈프리로 녹음하세요. 다시 누르면 멈춥니다."
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold am to talk, or tap am two times for hands-free. Press again to stop."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha pressionado para falar ou toque duas vezes para gravar sem as mãos. Pressione de novo para parar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте, чтобы говорить, или нажмите дважды для записи без рук. Нажмите ещё раз, чтобы остановить."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بولنے کے لیے دبائے رکھیں، یا ہینڈز فری کے لیے دو بار دبائیں۔ روکنے کے لیے دوبارہ دبائیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bosib turib gapiring yoki ikki marta bosib qo‘lsiz yozing. To‘xtatish uchun yana bosing."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住说话，或连按两次免手持录音。再按一次停止。"
          }
        }
      }
    },
