    "Pushga ulanib bo‘lmadi. Keyingi faollashishda qayta uriniladi." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر توصيل الإشعارات. سيعيد Echo المحاولة عند تنشيطه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বিজ্ঞপ্তি যুক্ত হয়নি। Echo আবার সক্রিয় হলে চেষ্টা করবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
