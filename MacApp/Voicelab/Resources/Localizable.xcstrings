    "Mikrofon bilan aloqa uzildi. Qurilmalarni yangilang yoki boshqa mikrofonni tanlang." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقطع الميكروفون. حدّث الأجهزة أو اختر ميكروفونًا آخر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মাইক্রোফোন বিচ্ছিন্ন হয়েছে। ডিভাইস রিফ্রেশ করুন বা অন্য মাইক্রোফোন বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon getrennt. Aktualisiere die Geräte oder wähle ein anderes Mikrofon."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The microphone disconnected. Refresh devices or choose another microphone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El micrófono se desconectó. Actualiza los dispositivos o elige otro micrófono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microphone déconnecté. Actualisez les appareils ou choisissez un autre microphone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "माइक्रोफ़ोन कट गया। डिवाइस रीफ़्रेश करें या दूसरा माइक्रोफ़ोन चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon terputus. Segarkan perangkat atau pilih mikrofon lain."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクが切断されました。機器を更新するか、別のマイクを選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마이크 연결이 끊겼습니다. 기기를 새로고침하거나 다른 마이크를 선택하세요."
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microphone disconnect. Refresh devices or choose another microphone."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O microfone desligou-se. Atualize os dispositivos ou escolha outro microfone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Микрофон отключён. Обновите список устройств или выберите другой микрофон."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مائیکروفون منقطع ہو گیا۔ آلات ریفریش کریں یا دوسرا مائیکروفون چنیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon bilan aloqa uzildi. Qurilmalarni yangilang yoki boshqa mikrofonni tanlang."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风已断开。请刷新设备或选择其他麦克风。"
          }
        }
      }
    },
    "Mikrofon diktovka va ovoz testi uchun, Accessibility esa matn kiritish uchun kerak." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الميكروفون للإملاء والاختبار؛ وتسهيلات الاستخدام لإدراج النص."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মাইক্রোফোন ডিকটেশন ও পরীক্ষার জন্য; অ্যাক্সেসিবিলিটি লেখা বসানোর জন্য।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofonzugriff dient zum Diktieren und Testen; Bedienungshilfen ermöglichen die Texteingabe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microphone access is used for dictation and testing; Accessibility enables text insertion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El micrófono se usa para dictado y pruebas; la accesibilidad permite insertar texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le microphone sert aux dictées et tests ; l’accessibilité permet l’insertion de texte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "माइक्रोफ़ोन डिक्टेशन और परीक्षण के लिए है; सुलभता टेक्स्ट डालने देती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon untuk dikte dan tes; aksesibilitas untuk menyisipkan teks."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクは音声入力とテスト用、アクセシビリティはテキスト挿入用です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마이크는 받아쓰기와 테스트에, 손쉬운 사용은 텍스트 삽입에 사용됩니다."
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microphone na for dictation and test; Accessibility allows text insertion."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O microfone serve para ditado e testes; a acessibilidade permite inserir texto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Микрофон нужен для диктовки и проверки звука, Accessibility — для вставки текста."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مائیکروفون ڈکٹیشن اور ٹیسٹ کے لیے؛ رسائی متن درج کرنے کے لیے ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
