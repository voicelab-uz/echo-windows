    "Sozlamalar asosiy oynaga ko‘chirildi va macOS uslubida qayta yaratildi." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نُقلت الإعدادات إلى النافذة الرئيسية وأُعيد تصميمها بأسلوب macOS."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সেটিংস মূল উইন্ডোতে আনা হয়েছে এবং macOS ধাঁচে নতুন করে সাজানো হয়েছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einstellungen sind jetzt im Hauptfenster und im macOS-Stil neu gestaltet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings now live in the main window, redesigned in the macOS style."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ajustes ahora están en la ventana principal, rediseñados al estilo de macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réglages sont désormais dans la fenêtre principale, repensés dans le style macOS."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेटिंग्स अब मुख्य विंडो में हैं और macOS शैली में नए सिरे से बनी हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengaturan kini ada di jendela utama, dengan desain baru bergaya macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定がメインウインドウに移り、macOSスタイルで一新されました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정이 메인 창으로 옮겨지고 macOS 스타일로 새롭게 디자인되었습니다."
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings don move inside the main window, with new macOS style."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os ajustes agora ficam na janela principal, redesenhados no estilo do macOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки теперь в главном окне и оформлены в стиле macOS."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سیٹنگز اب مرکزی ونڈو میں ہیں اور macOS انداز میں نئے سرے سے بنائی گئی ہیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sozlamalar asosiy oynaga ko‘chirildi va macOS uslubida qayta yaratildi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置已移至主窗口，并以 macOS 风格全新设计。"
          }
        }
      }
    },
