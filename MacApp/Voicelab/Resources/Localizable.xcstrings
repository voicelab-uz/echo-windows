    "Statistika: bugungi natijalar, tejalgan vaqt, faollik grafigi, yutuqlar va rekordlar." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإحصاءات: نتائج اليوم، والوقت الموفَّر، ومخطط النشاط، والإنجازات، والأرقام القياسية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পরিসংখ্যান: আজকের ফল, সাশ্রয় হওয়া সময়, কার্যকলাপ চার্ট, অর্জন ও রেকর্ড।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statistik: heutige Werte, gesparte Zeit, Aktivitätsdiagramm, Meilensteine und Rekorde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statistics: today’s numbers, time saved, an activity chart, milestones, and records."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estadísticas: cifras de hoy, tiempo ahorrado, gráfico de actividad, hitos y récords."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
