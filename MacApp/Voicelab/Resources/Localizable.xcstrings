    "Shu Mac’da yuklangan tarix asosida. To‘liq tarix yuklanmagan bo‘lishi mumkin." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعتمد على السجل المحمّل على هذا الـMac. قد لا تكون كل التسجيلات محمّلة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই Mac-এর লোড হওয়া ইতিহাস অনুযায়ী। কিছু রেকর্ডিং এখনও লোড না-ও হতে পারে।"
          }
        },
        "de" : {
          "stringUnit" : {
