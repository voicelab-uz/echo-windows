    "Tasdiqlash qabul qilindi. Echo oynasi avtomatik ochilmoqda. Bu tabni yopishingiz mumkin." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصل التأكيد. جارٍ فتح Echo تلقائيًا. يمكنك إغلاق هذا التبويب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নিশ্চিত করা হয়েছে। Echo নিজে থেকে খুলছে। এই ট্যাব বন্ধ করতে পারেন।"
          }
        },
        "de" : {
          "stringUnit" : {
