    "Mikrofon topilmadi. Qurilmani ulang yoki tizim mikrofonini tanlang." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد ميكروفون. وصّل واحدًا أو اختر ميكروفون النظام."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মাইক্রোফোন নেই। যুক্ত করুন বা সিস্টেম মাইক্রোফোন বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Mikrofon gefunden. Schließe eines an oder wähle das Systemmikrofon."
