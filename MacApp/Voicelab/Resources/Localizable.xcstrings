    "Almashtirish matni bo‘lsa, tanilgan ibora yozuv natijasida avtomatik almashtiriladi. Lug‘at shu Mac’da saqlanadi." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند تحديد بديل، تُستبدل العبارة المكتشفة تلقائيًا. تُحفظ المفردات على هذا الـMac."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বিকল্প নির্ধারিত থাকলে শনাক্ত বাক্যাংশ নিজে থেকেই বদলাবে। শব্দভান্ডার এই Mac-এ থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist eine Ersetzung festgelegt, wird die erkannte Phrase automatisch ersetzt. Das Wörterbuch bleibt auf diesem Mac."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If a replacement is set, the recognized phrase is replaced automatically. Vocabulary is stored on this Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si defines un reemplazo, la frase reconocida se sustituye automáticamente. El vocabulario se guarda en este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si défini, le remplacement est appliqué automatiquement à l’expression reconnue. Le vocabulaire reste sur ce Mac."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बदलाव तय होने पर पहचाना गया वाक्यांश अपने आप बदलता है। शब्दावली इस Mac पर रहती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika diatur, frasa yang dikenali diganti otomatis. Kosakata disimpan di Mac ini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "置換を設定すると、認識されたフレーズが自動的に置き換わります。辞書はこのMacに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대체 내용을 설정하면 인식한 문구가 자동 교체됩니다. 단어장은 이 Mac에 저장됩니다."
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
