    "Oldingi so‘rov bajarilgan bo‘lsa, qayta yuborish tarifingizdagi vaqtni yana sarflashi mumkin." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إن عولج الطلب السابق، فقد يستهلك إرساله مجددًا من الرصيد مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আগের অনুরোধ সম্পন্ন হয়ে থাকলে আবার পাঠানোয় প্ল্যানের সময় আবার খরচ হতে পারে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wurde die vorige Anfrage verarbeitet, kann erneutes Senden nochmals Kontingent verbrauchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the previous request was processed, sending again may use your allowance again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la solicitud anterior se procesó, reenviarla puede consumir de nuevo tu tiempo disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la demande précédente a été traitée, un nouvel envoi peut consommer à nouveau votre quota."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पिछला अनुरोध पूरा हुआ हो तो दोबारा भेजने पर योजना का समय फिर खर्च हो सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika permintaan sebelumnya sudah diproses, mengirim ulang bisa memakai kuota lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前のリクエストが処理済みの場合、再送信で利用枠を再び消費することがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전 요청이 처리됐다면 재전송 시 이용 시간이 다시 차감될 수 있습니다."
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the last request don process, sending again fit use your plan time again."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o pedido anterior foi processado, reenviar pode consumir novamente o tempo do plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если предыдущий запрос уже обработан, повторная отправка может снова потратить время по тарифу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پچھلی درخواست مکمل ہو چکی ہو تو دوبارہ بھیجنے سے پلان کا وقت پھر خرچ ہو سکتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oldingi so‘rov bajarilgan bo‘lsa, qayta yuborish tarifingizdagi vaqtni yana sarflashi mumkin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果上次请求已处理，重新发送可能再次消耗额度。"
          }
        }
      }
    },
    "Oldingi so‘rov serverda bajarilgan bo‘lsa, qayta yuborish yana foydalanish vaqtini sarflashi mumkin." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إن عولج الطلب السابق، فقد يستهلك إرساله مجددًا رصيدًا إضافيًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আগের অনুরোধ সম্পন্ন হয়ে থাকলে আবার পাঠানোয় আরও সময় খরচ হতে পারে।"
