    "Ilovalar faqat ularga matn yuborilgan diktovkalarda hisoblanadi. Eski yozuvlar uchun ilova noma’lum." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحسب التطبيقات عند إرسال الإملاء إليها. التسجيلات القديمة بلا تطبيق محدد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডিকটেশন পাঠালে অ্যাপের ব্যবহার গোনা হয়। পুরোনো রেকর্ডিংয়ে অ্যাপের তথ্য নেই।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps werden gezählt, wenn Diktate an sie gesendet werden. Ältere Aufnahmen haben keine App-Zuordnung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps are counted when dictation is sent to them. Older recordings have no app attribution."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las aplicaciones se cuentan al recibir un dictado. Las grabaciones antiguas no tienen aplicación asociada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les applications sont comptées lorsqu’une dictée leur est envoyée. Les anciens enregistrements ne sont associés à aucune application."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप को डिक्टेशन भेजने पर उसकी गिनती होती है। पुरानी रिकॉर्डिंग में ऐप की जानकारी नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi dihitung saat menerima dikte. Rekaman lama tidak memiliki atribusi aplikasi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声入力を送信したアプリを集計します。古い録音にはアプリ情報がありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "받아쓰기를 전송한 앱만 집계합니다. 이전 녹음에는 앱 정보가 없습니다."
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We count apps when dictation go to them. Old recordings no get app details."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As aplicações são contadas quando recebem um ditado. As gravações antigas não têm aplicação associada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложения учитываются при отправке в них текста. Для старых записей приложение неизвестно."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایپ کو ڈکٹیشن بھیجنے پر شمار کیا جاتا ہے۔ پرانی ریکارڈنگز میں ایپ کی تفصیل نہیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilovalar faqat ularga matn yuborilgan diktovkalarda hisoblanadi. Eski yozuvlar uchun ilova noma’lum."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向应用发送听写时才会计入统计。旧录音没有关联的应用。"
          }
        }
      }
    },
    "Ilovalar statistikasi hozir shu Mac’dagi tarixdan ko‘rsatilmoqda." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعكس إحصاءات التطبيقات حاليًا سجل هذا الـMac."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখন অ্যাপ ব্যবহার এই Mac-এর ইতিহাস অনুযায়ী দেখানো হচ্ছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App-Nutzung basiert derzeit auf dem Verlauf dieses Macs."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App usage currently reflects history on this Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El uso de aplicaciones refleja actualmente el historial de este Mac."
