        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connexion aux notifications impossible. Echo réessaiera à la prochaine activation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सूचनाएँ नहीं जुड़ सकीं। Echo सक्रिय होने पर फिर कोशिश करेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
