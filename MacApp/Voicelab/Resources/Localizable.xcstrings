    "Matn kursor turgan joyga joylanadi; matn maydoni bo‘lmasa, buferga nusxalanadi." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُدرج النص حيث يوجد المؤشر؛ وإن لم يوجد حقل نص يُنسخ إلى الحافظة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লেখা কার্সরের জায়গায় বসে; লেখার ঘর না থাকলে ক্লিপবোর্ডে কপি হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text landet dort, wo der Cursor steht; ohne Textfeld wird er in die Zwischenablage kopiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text goes wherever your cursor is; with no text field, it’s copied to the clipboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El texto va donde esté el cursor; si no hay campo de texto, se copia al portapapeles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le texte va là où se trouve le curseur ; sans champ de texte, il est copié dans le presse-papiers."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टेक्स्ट वहीं जाता है जहाँ कर्सर है; टेक्स्ट फ़ील्ड न हो तो क्लिपबोर्ड पर कॉपी होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teks masuk ke posisi kursor; jika tidak ada kolom teks, teks disalin ke papan klip."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキストはカーソルの位置に入力され、入力欄がなければクリップボードにコピーされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트가 커서 위치에 입력되고, 입력란이 없으면 클립보드에 복사됩니다."
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text go enter where your cursor dey; if no text box, e go copy to clipboard."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O texto vai para onde estiver o cursor; sem campo de texto, é copiado para a área de transferência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текст вставляется туда, где курсор; если поля нет, он копируется в буфер обмена."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متن وہیں جاتا ہے جہاں کرسر ہو؛ ٹیکسٹ فیلڈ نہ ہو تو کلپ بورڈ پر کاپی ہو جاتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matn kursor turgan joyga joylanadi; matn maydoni bo‘lmasa, buferga nusxalanadi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文本会放到光标所在位置；若没有文本框，则拷贝到剪贴板。"
          }
        }
      }
    },
