    "Shortcut yozuvni boshlaydi va tugatadi. Bir yozuv 10 daqiqagacha. Matn yozuv boshlangan ilova hali faol bo‘lsa joylanadi." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدأ الاختصار التسجيل ويوقفه، بحد أقصى 10 دقائق. يُدرج النص إن ظل التطبيق الأصلي نشطًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শর্টকাট সর্বোচ্চ ১০ মিনিটের রেকর্ডিং শুরু ও বন্ধ করে। মূল অ্যাপ সক্রিয় থাকলে লেখা বসে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Kürzel startet und stoppt Aufnahmen von bis zu 10 Minuten. Text wird eingefügt, wenn die ursprüngliche App noch aktiv ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The shortcut starts and stops recording, up to 10 minutes per recording. Text is inserted if the original app is still active."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El atajo inicia y detiene grabaciones de hasta 10 minutos. El texto se inserta si la aplicación original sigue activa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le raccourci démarre et arrête les enregistrements, limités à 10 minutes. Le texte est inséré si l’application d’origine est toujours active."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शॉर्टकट 10 मिनट तक की रिकॉर्डिंग शुरू और बंद करता है। मूल ऐप सक्रिय हो तभी टेक्स्ट डलता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pintasan memulai dan menghentikan rekaman hingga 10 menit. Teks disisipkan jika aplikasi awal masih aktif."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカットで最大10分の録音を開始・終了します。元のアプリがアクティブな場合にテキストを挿入します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축키로 최대 10분의 녹음을 시작하고 중지합니다. 원래 앱이 활성 상태일 때 텍스트를 삽입합니다."
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shortcut starts and stops recording, up to 10 minutes each. Text go enter if the original app still active."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O atalho inicia e termina gravações de até 10 minutos. O texto é inserido se a aplicação original continuar ativa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сочетание клавиш начинает и завершает запись длительностью до 10 минут. Текст вставляется, если исходное приложение всё ещё активно."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شارٹ کٹ 10 منٹ تک کی ریکارڈنگ شروع اور بند کرتا ہے۔ اصل ایپ فعال ہو تو متن درج ہوتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shortcut yozuvni boshlaydi va tugatadi. Bir yozuv 10 daqiqagacha. Matn yozuv boshlangan ilova hali faol bo‘lsa joylanadi."
          }
        },
