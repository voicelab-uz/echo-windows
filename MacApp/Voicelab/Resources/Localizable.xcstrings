    "Hisob: klaviatura — 40 so‘z/daq; o‘lchov bo‘lmasa ovoz — 130 so‘z/daq. Tahrirlash va kutish vaqti hisobga olinmagan." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقدير: لوحة المفاتيح 40 كلمة/دقيقة؛ الصوت 130 كلمة/دقيقة إن لم يُقس. لا يشمل التحرير والانتظار."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অনুমান: কীবোর্ডে ৪০ শব্দ/মিনিট; না মাপলে কথায় ১৩০ শব্দ/মিনিট। সম্পাদনা ও অপেক্ষা বাদ।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schätzung: Tastatur — 40 Wörter/Min.; Stimme ohne Messung — 130 Wörter/Min. Ohne Bearbeitungs- und Wartezeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimate: keyboard — 40 words/min; voice — 130 words/min if not measured. Editing and waiting time are excluded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimación: teclado — 40 palabras/min; voz sin medición — 130 palabras/min. No incluye edición ni espera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimation : clavier — 40 mots/min ; voix sans mesure — 130 mots/min. Hors correction et attente."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुमान: कीबोर्ड — 40 शब्द/मिनट; माप न होने पर आवाज़ — 130 शब्द/मिनट। संपादन और प्रतीक्षा शामिल नहीं हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perkiraan: papan ketik — 40 kata/mnt; suara tanpa pengukuran — 130 kata/mnt. Tidak termasuk menyunting dan menunggu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推定：キーボードは40語/分、音声は未測定の場合130語/分。編集と待ち時間は含みません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추정: 키보드 분당 40단어, 음성 미측정 시 분당 130단어. 편집과 대기 시간은 제외됩니다."
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimate: keyboard — 40 words/min; voice — 130 words/min if we never measure am. Editing and waiting time no join."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimativa: teclado — 40 palavras/min; voz — 130 palavras/min sem medição. Exclui edição e espera."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расчёт: клавиатура — 40 слов/мин; голос без замера — 130 слов/мин. Время редактирования и ожидания не учитывается."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تخمینہ: کی بورڈ 40 الفاظ/منٹ؛ پیمائش نہ ہو تو آواز 130 الفاظ/منٹ۔ ترمیم اور انتظار شامل نہیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hisob: klaviatura — 40 so‘z/daq; o‘lchov bo‘lmasa ovoz — 130 so‘z/daq. Tahrirlash va kutish vaqti hisobga olinmagan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "估算：键盘每分钟 40 个字词；未测量时语音每分钟 130 个字词。不含编辑和等待时间。"
          }
        }
      }
    },
    "Hisobingiz bulutli transkripsiyani ochadi va tarixingizni bir joyda saqlaydi." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتيح حسابك التحويل السحابي ويجمع السجل في مكان واحد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাকাউন্ট ক্লাউড ট্রান্সক্রিপশন চালু করে এবং ইতিহাস এক জায়গায় রাখে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto ermöglicht Cloud-Transkription und bündelt deinen Verlauf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account unlocks cloud transcription and keeps your history in one place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta habilita la transcripción en la nube y reúne tu historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte active la transcription dans le cloud et regroupe votre historique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खाता क्लाउड ट्रांसक्रिप्शन खोलता है और इतिहास एक जगह रखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akun Anda mengaktifkan transkripsi cloud dan menyatukan riwayat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントでクラウド文字起こしを利用し、履歴をまとめて保存できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정으로 클라우드 변환을 사용하고 기록을 한곳에 보관하세요."
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account opens cloud transcription and keeps your history together."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua conta ativa a transcrição na nuvem e reúne o histórico num só lugar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аккаунт открывает облачное распознавание и хранит историю в одном месте."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اکاؤنٹ کلاؤڈ ٹرانسکرپشن کھولتا اور تاریخ ایک جگہ رکھتا ہے۔"
