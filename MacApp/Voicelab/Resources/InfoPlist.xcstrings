        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Echo الميكروفون لتحويل كلامك إلى نص."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo আপনার কথা লেখায় রূপান্তর করতে মাইক্রোফোন ব্যবহার করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo verwendet dein Mikrofon, um deine Sprache in Text umzuwandeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo uses your microphone to turn your speech into text."
          }
        },
