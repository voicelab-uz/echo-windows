# Copy to Configuration/release.env.local (gitignored).
# This is shell configuration. Load only a file you trust:
#   set -a
#   source Configuration/release.env.local
#   set +a

# Confirmed publishing team, also used by the Xcode project and previous VoiceLab
# app. These identifiers are public metadata, not credentials.
ECHO_TEAM_ID="FWCSVFT76D"

# The 40-character SHA-1 of your Developer ID Application identity (not Apple
# Development/Distribution). Find it with: security find-identity -v -p codesigning
# This identity must also be installed with its private key on your build Mac.
ECHO_SIGNING_IDENTITY="B443163B7E1C67F9F7FF981137A23B90887EB3AF"

# Create this profile in your own Keychain using docs/CDN_RELEASE.md.
ECHO_NOTARY_PROFILE="echo-notary"
# Optional custom Keychain containing this notarization profile (CI).
ECHO_NOTARY_KEYCHAIN=""
ECHO_NOTARY_TIMEOUT="30m"

# Opt in only when a Developer ID profile authorizes this exact app/team and
# production APNs. Keep the downloaded profile OUTSIDE this checkout.
# The release script validates it, installs a verified copy into Xcode's profile
# directory, and checks the embedded profile again after archive/export.
ECHO_PUSH_ENABLED="0"
ECHO_PUSH_PROFILE=""
# Example for an opted-in release:
# ECHO_PUSH_ENABLED="1"
# ECHO_PUSH_PROFILE="/absolute/private-build-inputs/Echo_Developer_ID.provisionprofile"

# Automatic updates require a universal build; architecture-specific feeds are not shipped.
ECHO_ARCHS="arm64 x86_64"

# CDN credentials are deliberately not loaded by release.sh. Configure them in
# your provider's CLI/CI secret store once the origin/provider is selected.

# Sparkle settings are public configuration, never private key material.
# Public artifacts-only GitHub repository. The application source remains private.
# Provision/verify the repository and immutable release setting before publishing.
ECHO_UPDATE_HOST_MODE="github"
ECHO_UPDATE_CHANNEL="stable"
ECHO_UPDATE_FEED_URL="https://raw.githubusercontent.com/voicelab-uz/echo-releases/main/stable/appcast.xml"
ECHO_UPDATE_RELEASE_BASE_URL="https://github.com/voicelab-uz/echo-releases/releases/download"
# Self-hosted alternative: ECHO_UPDATE_HOST_MODE=cdn and both URLs on your CDN host.
# Proposed CDN paths remain unprovisioned; see docs/CDN_RELEASE.md.
# Confirmed public key; private signing material remains in Keychain.
ECHO_SPARKLE_PUBLIC_KEY="XzFmEWjxWA+1rQc1mHl1tokbcYSWaSJMcCvFEOLwLHc="
# Keychain account for Sparkle sign_update (not a private key).
ECHO_SPARKLE_KEY_ACCOUNT="uz.voicelab.echo.updates"
# bin/ from the checksum-pinned Sparkle 2.10.1 distribution; see the runbook.
ECHO_SPARKLE_TOOLS_DIR=""
# Highest build ever published across all channels. 0 is for first release only.
ECHO_PREVIOUS_BUILD=""
# Dirty source is rejected except an explicit test build (never stable/beta).
ECHO_ALLOW_DIRTY_TEST="0"
